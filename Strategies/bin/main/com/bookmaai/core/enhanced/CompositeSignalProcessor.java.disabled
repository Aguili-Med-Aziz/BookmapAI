    private Map<SignalType, Double> getCurrentWeights() {
        Map<SignalType, Double> weights = new HashMap<>();
        weights.put(SignalType.ICEBERG, icebergWeight);
        weights.put(SignalType.ABSORPTION, absorptionWeight);
        weights.put(SignalType.IMBALANCE, imbalanceWeight);
        return weights;
    }
    
    private void updateDynamicWeights(Map<SignalType, Double> newWeights) {
        this.icebergWeight = newWeights.getOrDefault(SignalType.ICEBERG, icebergWeight);
        this.absorptionWeight = newWeights.getOrDefault(SignalType.ABSORPTION, absorptionWeight);
        this.imbalanceWeight = newWeights.getOrDefault(SignalType.IMBALANCE, imbalanceWeight);
        
        System.out.println(String.format("🎯 Dynamic weights updated: Iceberg=%.3f, Absorption=%.3f, Imbalance=%.3f",
                          icebergWeight, absorptionWeight, imbalanceWeight));
    }
    
    private void updatePerformanceMetrics() {
        // Update signal performance tracking
        System.out.println(String.format("📊 [CompositeSignal] Total: %d, Strong: %d, Conflicts: %d, Success: %d",
            totalSignals.get(), strongSignals.get(), conflictingSignals.get(), successfulSignals.get()));
    }
    
