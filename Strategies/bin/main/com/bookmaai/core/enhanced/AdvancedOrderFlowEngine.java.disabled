    private final ScheduledExecutorService scheduler = Executors.newScheduledThreadPool(6);
    
    // Performance tracking
    private final AtomicLong totalEventsProcessed = new AtomicLong(0);
    private final AtomicLong patternsDetected = new AtomicLong(0);
    private final AtomicLong alertsGenerated = new AtomicLong(0);
    
    // Real-time results storage
    private final Map<String, OrderFlowAnalysis> currentAnalysis = new ConcurrentHashMap<>();
