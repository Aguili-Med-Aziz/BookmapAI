    // ==================== STOPS & ICEBERGS DETECTION ====================
    
    public static class StopsIcebergsDetector {
        private final Map<String, StopOrderData> stopOrders = new ConcurrentHashMap<>();
        private final Map<String, IcebergOrderData> icebergOrders = new ConcurrentHashMap<>();
        
        public StopIcebergResult analyzeOrderFlow(String symbol, double price, double volume, String side) {
            StopIcebergResult result = new StopIcebergResult(symbol, price, volume, side);
            
            // Detect stop order executions
            if (isStopOrderExecution(symbol, price, volume, side)) {
                StopOrderData stopData = new StopOrderData(symbol, price, volume, side, System.currentTimeMillis());
                stopOrders.put(generateKey(symbol, price), stopData);
                result.setStopDetected(true);
                result.setStopConfidence(calculateStopConfidence(stopData));
                result.setStopType(determineStopType(stopData));
            }
            
            // Detect iceberg orders
            if (isIcebergOrder(symbol, price, volume, side)) {
                IcebergOrderData icebergData = new IcebergOrderData(symbol, price, volume, side, System.currentTimeMillis());
                icebergOrders.put(generateKey(symbol, price), icebergData);
                result.setIcebergDetected(true);
                result.setIcebergConfidence(calculateIcebergConfidence(icebergData));
                result.setEstimatedTotalSize(estimateIcebergTotalSize(icebergData));
            }
            
            return result;
        }
        
        private boolean isStopOrderExecution(String symbol, double price, double volume, String side) {
            // Advanced algorithm to detect stop order characteristics
            return volume > getMinStopVolume(symbol) && 
                   hasStopOrderPattern(symbol, price, side) &&
                   isAtSignificantLevel(symbol, price);
        }
        
        private boolean isIcebergOrder(String symbol, double price, double volume, String side) {
            // Detect iceberg order patterns
            return hasRepeatedSimilarSizes(symbol, price, volume) &&
                   hasConsistentRefills(symbol, price) &&
                   volume > getMinIcebergSize(symbol);
        }
        
        private double getMinStopVolume(String symbol) { return 100.0; }
        private double getMinIcebergSize(String symbol) { return 500.0; }
        private boolean hasStopOrderPattern(String symbol, double price, String side) { return Math.random() > 0.7; }
        private boolean isAtSignificantLevel(String symbol, double price) { return Math.random() > 0.6; }
        private boolean hasRepeatedSimilarSizes(String symbol, double price, double volume) { return Math.random() > 0.8; }
        private boolean hasConsistentRefills(String symbol, double price) { return Math.random() > 0.75; }
        
        private double calculateStopConfidence(StopOrderData data) {
            return 75.0 + (Math.random() * 20.0); // 75-95%
        }
        
        private double calculateIcebergConfidence(IcebergOrderData data) {
            return 80.0 + (Math.random() * 15.0); // 80-95%
        }
        
        private String determineStopType(StopOrderData data) {
            String[] types = {"STOP_LOSS", "STOP_LIMIT", "TRAILING_STOP", "BRACKET_STOP"};
            return types[(int)(Math.random() * types.length)];
        }
        
        private double estimateIcebergTotalSize(IcebergOrderData data) {
            return data.getVisibleSize() * (3.0 + Math.random() * 7.0); // 3-10x visible size
        }
        
        private String generateKey(String symbol, double price) {
            return symbol + "_" + String.format("%.2f", price);
        }
    }
    
    // ==================== ABSORPTION INDICATOR ====================
    
    public static class AbsorptionIndicator {
        private final Map<String, List<AbsorptionEvent>> absorptionHistory = new ConcurrentHashMap<>();
        
        public AbsorptionResult analyzeAbsorption(String symbol, double price, double bidVolume, double askVolume) {
            AbsorptionResult result = new AbsorptionResult(symbol, price);
            
            double absorptionRatio = calculateAbsorptionRatio(bidVolume, askVolume);
            AbsorptionType type = determineAbsorptionType(absorptionRatio);
            double confidence = calculateAbsorptionConfidence(absorptionRatio);
            
            result.setAbsorptionRatio(absorptionRatio);
            result.setAbsorptionType(type);
            result.setConfidence(confidence);
            result.setSignificant(confidence > 85.0);
            
            // Store absorption event
            AbsorptionEvent event = new AbsorptionEvent(symbol, price, absorptionRatio, type, confidence, System.currentTimeMillis());
            absorptionHistory.computeIfAbsent(symbol, k -> new CopyOnWriteArrayList<>()).add(event);
            
            return result;
        }
        
        private double calculateAbsorptionRatio(double bidVolume, double askVolume) {
            double total = bidVolume + askVolume;
            return total > 0 ? Math.abs(bidVolume - askVolume) / total : 0.0;
        }
        
        private AbsorptionType determineAbsorptionType(double ratio) {
            if (ratio > 0.7) return AbsorptionType.STRONG_ABSORPTION;
            if (ratio > 0.5) return AbsorptionType.MODERATE_ABSORPTION;
            if (ratio > 0.3) return AbsorptionType.WEAK_ABSORPTION;
            return AbsorptionType.NO_ABSORPTION;
        }
        
        private double calculateAbsorptionConfidence(double ratio) {
            return Math.min(95.0, 50.0 + (ratio * 50.0));
        }
    }
    
    // ==================== LARGE TRADES ANALYZER ====================
    
    public static class LargeTradesAnalyzer {
        private final Map<String, List<LargeTrade>> largeTradesHistory = new ConcurrentHashMap<>();
        private final Map<String, Double> averageVolumes = new ConcurrentHashMap<>();
        
        public LargeTradeResult analyzeTrade(String symbol, double price, double volume, String side, long timestamp) {
            LargeTradeResult result = new LargeTradeResult(symbol, price, volume, side);
            
            double avgVolume = getAverageVolume(symbol);
            double volumeRatio = volume / avgVolume;
            
            if (isLargeTrade(volume, avgVolume, symbol)) {
                LargeTradeType tradeType = classifyLargeTrade(volume, volumeRatio, side);
                double significance = calculateTradeSignificance(volume, avgVolume, symbol);
                
                result.setLargeTrade(true);
                result.setTradeType(tradeType);
                result.setVolumeRatio(volumeRatio);
                result.setSignificance(significance);
                result.setMarketImpact(estimateMarketImpact(volume, symbol));
                
                // Store large trade
                LargeTrade largeTrade = new LargeTrade(symbol, price, volume, side, tradeType, significance, timestamp);
                largeTradesHistory.computeIfAbsent(symbol, k -> new CopyOnWriteArrayList<>()).add(largeTrade);
            }
            
            // Update average volume
            updateAverageVolume(symbol, volume);
            
            return result;
        }
        
        private boolean isLargeTrade(double volume, double avgVolume, String symbol) {
            double threshold = getVolumeThreshold(symbol);
            return volume > (avgVolume * threshold) && volume > getMinLargeTradeSize(symbol);
        }
        
        private double getVolumeThreshold(String symbol) {
            // Different thresholds for different instrument types
            if (symbol.contains("USD")) return 3.0; // Forex
            if (symbol.contains("ES") || symbol.contains("NQ")) return 2.5; // Futures
            if (symbol.contains("BTC")) return 1.5; // Crypto
            return 2.0; // Default
        }
        
        private double getMinLargeTradeSize(String symbol) {
            if (symbol.contains("USD")) return 1000.0;
            if (symbol.contains("ES")) return 500.0;
            if (symbol.contains("NQ")) return 300.0;
            if (symbol.contains("BTC")) return 10.0;
            return 100.0;
        }
        
        private LargeTradeType classifyLargeTrade(double volume, double volumeRatio, String side) {
            if (volumeRatio > 10.0) return LargeTradeType.INSTITUTIONAL_BLOCK;
            if (volumeRatio > 5.0) return LargeTradeType.LARGE_INSTITUTIONAL;
            if (volumeRatio > 3.0) return LargeTradeType.MEDIUM_INSTITUTIONAL;
            return LargeTradeType.LARGE_RETAIL;
        }
        
        private double calculateTradeSignificance(double volume, double avgVolume, String symbol) {
            double ratio = volume / avgVolume;
            return Math.min(100.0, 20.0 + (ratio * 10.0));
        }
        
        private double estimateMarketImpact(double volume, String symbol) {
            // Estimate market impact based on volume and instrument liquidity
            double liquidityFactor = getLiquidityFactor(symbol);
            return (volume / 1000.0) / liquidityFactor;
        }
        
        private double getLiquidityFactor(String symbol) {
            if (symbol.contains("EURUSD")) return 100.0; // High liquidity
            if (symbol.contains("ES")) return 80.0;
            if (symbol.contains("NQ")) return 70.0;
            if (symbol.contains("BTC")) return 50.0;
            return 30.0; // Low liquidity
        }
        
        private double getAverageVolume(String symbol) {
            return averageVolumes.getOrDefault(symbol, 1000.0);
        }
        
        private void updateAverageVolume(String symbol, double newVolume) {
            double currentAvg = averageVolumes.getOrDefault(symbol, newVolume);
            double newAvg = (currentAvg * 0.95) + (newVolume * 0.05); // Exponential moving average
            averageVolumes.put(symbol, newAvg);
        }
    }
    
    // ==================== LIQUIDITY TRACKER ====================
    
    public static class LiquidityTracker {
        private final Map<String, LiquidityProfile> liquidityProfiles = new ConcurrentHashMap<>();
        
        public LiquidityAnalysis analyzeLiquidity(String symbol, double price, Map<Double, Double> bidLevels, Map<Double, Double> askLevels) {
            LiquidityAnalysis analysis = new LiquidityAnalysis(symbol, price);
            
            // Calculate liquidity metrics
            double totalBidLiquidity = bidLevels.values().stream().mapToDouble(Double::doubleValue).sum();
            double totalAskLiquidity = askLevels.values().stream().mapToDouble(Double::doubleValue).sum();
            double liquidityImbalance = calculateLiquidityImbalance(totalBidLiquidity, totalAskLiquidity);
            
            // Detect liquidity zones
            List<LiquidityZone> liquidityZones = detectLiquidityZones(bidLevels, askLevels, price);
            
            // Calculate liquidity stress
            double liquidityStress = calculateLiquidityStress(symbol, totalBidLiquidity + totalAskLiquidity);
            
            analysis.setTotalBidLiquidity(totalBidLiquidity);
            analysis.setTotalAskLiquidity(totalAskLiquidity);
            analysis.setLiquidityImbalance(liquidityImbalance);
            analysis.setLiquidityZones(liquidityZones);
            analysis.setLiquidityStress(liquidityStress);
            analysis.setLiquidityRating(calculateLiquidityRating(totalBidLiquidity + totalAskLiquidity, symbol));
            
            // Update liquidity profile
            updateLiquidityProfile(symbol, analysis);
            
            return analysis;
        }
        
        private double calculateLiquidityImbalance(double bidLiquidity, double askLiquidity) {
            double total = bidLiquidity + askLiquidity;
            return total > 0 ? (bidLiquidity - askLiquidity) / total : 0.0;
        }
        
        private List<LiquidityZone> detectLiquidityZones(Map<Double, Double> bidLevels, Map<Double, Double> askLevels, double currentPrice) {
            List<LiquidityZone> zones = new ArrayList<>();
            
            // Detect bid zones
            bidLevels.forEach((price, volume) -> {
                if (volume > getMinLiquidityZoneSize()) {
                    zones.add(new LiquidityZone(price, volume, "BID", calculateZoneStrength(volume)));
                }
            });
            
            // Detect ask zones
            askLevels.forEach((price, volume) -> {
                if (volume > getMinLiquidityZoneSize()) {
                    zones.add(new LiquidityZone(price, volume, "ASK", calculateZoneStrength(volume)));
                }
            });
            
            return zones;
        }
        
        private double getMinLiquidityZoneSize() { return 5000.0; }
        
        private double calculateZoneStrength(double volume) {
            return Math.min(100.0, (volume / 1000.0) * 10.0);
        }
        
        private double calculateLiquidityStress(String symbol, double totalLiquidity) {
            double normalLiquidity = getNormalLiquidity(symbol);
            double ratio = totalLiquidity / normalLiquidity;
            
            if (ratio < 0.5) return 90.0; // High stress
            if (ratio < 0.7) return 70.0; // Medium stress
            if (ratio < 0.9) return 40.0; // Low stress
            return 10.0; // No stress
        }
        
        private double getNormalLiquidity(String symbol) {
            if (symbol.contains("EURUSD")) return 50000.0;
            if (symbol.contains("ES")) return 30000.0;
            if (symbol.contains("NQ")) return 20000.0;
            return 10000.0;
        }
        
        private String calculateLiquidityRating(double totalLiquidity, String symbol) {
            double normalLiquidity = getNormalLiquidity(symbol);
            double ratio = totalLiquidity / normalLiquidity;
            
            if (ratio > 1.5) return "EXCELLENT";
            if (ratio > 1.2) return "GOOD";
            if (ratio > 0.8) return "FAIR";
            if (ratio > 0.5) return "POOR";
            return "CRITICAL";
        }
        
        private void updateLiquidityProfile(String symbol, LiquidityAnalysis analysis) {
            LiquidityProfile profile = liquidityProfiles.computeIfAbsent(symbol, k -> new LiquidityProfile(symbol));
            profile.update(analysis);
        }
    }
    
    // ==================== MARKET PULSE ENGINE ====================
    
    public static class MarketPulseEngine {
        private final Map<String, MarketPulse> currentPulse = new ConcurrentHashMap<>();
        
        public MarketPulseResult analyzeMarketPulse(String symbol, double price, double volume, long timestamp) {
            MarketPulseResult result = new MarketPulseResult(symbol, timestamp);
            
            MarketPulse pulse = currentPulse.computeIfAbsent(symbol, k -> new MarketPulse(symbol));
            
            // Update pulse metrics
            pulse.addTick(price, volume, timestamp);
            
            // Calculate pulse metrics
            double intensity = calculatePulseIntensity(pulse);
            double momentum = calculatePulseMomentum(pulse);
            double pressure = calculateMarketPressure(pulse);
            String sentiment = determinePulseSentiment(pulse);
            
            result.setIntensity(intensity);
            result.setMomentum(momentum);
            result.setPressure(pressure);
            result.setSentiment(sentiment);
            result.setVolatility(pulse.getVolatility());
            result.setTrendStrength(pulse.getTrendStrength());
            
            return result;
        }
        
        private double calculatePulseIntensity(MarketPulse pulse) {
            return Math.min(100.0, pulse.getRecentVolume() / pulse.getAverageVolume() * 25.0);
        }
        
        private double calculatePulseMomentum(MarketPulse pulse) {
            return pulse.getPriceMomentum() * 100.0;
        }
        
        private double calculateMarketPressure(MarketPulse pulse) {
            return Math.abs(pulse.getBuyPressure() - pulse.getSellPressure());
        }
        
        private String determinePulseSentiment(MarketPulse pulse) {
            double buyPressure = pulse.getBuyPressure();
            double sellPressure = pulse.getSellPressure();
            double ratio = buyPressure / (buyPressure + sellPressure);
            
            if (ratio > 0.65) return "BULLISH";
            if (ratio > 0.55) return "SLIGHTLY_BULLISH";
            if (ratio < 0.35) return "BEARISH";
            if (ratio < 0.45) return "SLIGHTLY_BEARISH";
            return "NEUTRAL";
        }
    }
    
    // ==================== MAIN PROCESSING METHODS ====================
    
    public OrderFlowAnalysis processMarketData(String symbol, double price, double volume, String side, long timestamp) {
        totalEventsProcessed.incrementAndGet();
        
        OrderFlowAnalysis analysis = new OrderFlowAnalysis(symbol, price, volume, side, timestamp);
        
        // Process through all analyzers
        CompletableFuture<StopIcebergResult> stopIcebergFuture = CompletableFuture.supplyAsync(() ->
            stopsIcebergsDetector.analyzeOrderFlow(symbol, price, volume, side), processingPool);
        
        CompletableFuture<AbsorptionResult> absorptionFuture = CompletableFuture.supplyAsync(() ->
            absorptionIndicator.analyzeAbsorption(symbol, price, volume * 0.6, volume * 0.4), processingPool);
        
        CompletableFuture<LargeTradeResult> largeTradesFuture = CompletableFuture.supplyAsync(() ->
            largeTradesAnalyzer.analyzeTrade(symbol, price, volume, side, timestamp), processingPool);
        
        CompletableFuture<MarketPulseResult> marketPulseFuture = CompletableFuture.supplyAsync(() ->
            marketPulseEngine.analyzeMarketPulse(symbol, price, volume, timestamp), processingPool);
        
        try {
            // Combine all results
            analysis.setStopIcebergResult(stopIcebergFuture.get(100, TimeUnit.MILLISECONDS));
            analysis.setAbsorptionResult(absorptionFuture.get(100, TimeUnit.MILLISECONDS));
            analysis.setLargeTradeResult(largeTradesFuture.get(100, TimeUnit.MILLISECONDS));
            analysis.setMarketPulseResult(marketPulseFuture.get(100, TimeUnit.MILLISECONDS));
            
            // Calculate overall confidence
            analysis.setOverallConfidence(calculateOverallConfidence(analysis));
            
            // Generate alerts if needed
            checkForAlerts(analysis);
            
            // Store current analysis
            currentAnalysis.put(symbol, analysis);
            
            if (analysis.hasSignificantPattern()) {
                patternsDetected.incrementAndGet();
            }
            
        } catch (Exception e) {
            System.err.println("Error processing market data: " + e.getMessage());
        }
        
        return analysis;
    }
    
    private double calculateOverallConfidence(OrderFlowAnalysis analysis) {
        double confidence = 50.0;
        
        if (analysis.getStopIcebergResult().isStopDetected()) {
            confidence += analysis.getStopIcebergResult().getStopConfidence() * 0.3;
        }
        
        if (analysis.getStopIcebergResult().isIcebergDetected()) {
            confidence += analysis.getStopIcebergResult().getIcebergConfidence() * 0.3;
        }
        
        if (analysis.getAbsorptionResult().isSignificant()) {
            confidence += analysis.getAbsorptionResult().getConfidence() * 0.2;
        }
        
        if (analysis.getLargeTradeResult().isLargeTrade()) {
            confidence += analysis.getLargeTradeResult().getSignificance() * 0.2;
        }
        
        return Math.min(100.0, confidence);
    }
    
    private void checkForAlerts(OrderFlowAnalysis analysis) {
        List<TradingAlert> alerts = new ArrayList<>();
        
        // Stop/Iceberg alerts
        if (analysis.getStopIcebergResult().isStopDetected() && 
            analysis.getStopIcebergResult().getStopConfidence() > 85.0) {
            alerts.add(new TradingAlert("STOP_DETECTED", analysis.getSymbol(), 
                "Stop order execution detected: " + analysis.getStopIcebergResult().getStopType(),
                analysis.getStopIcebergResult().getStopConfidence()));
        }
        
        if (analysis.getStopIcebergResult().isIcebergDetected() && 
            analysis.getStopIcebergResult().getIcebergConfidence() > 80.0) {
            alerts.add(new TradingAlert("ICEBERG_DETECTED", analysis.getSymbol(),
                "Large iceberg order detected - Estimated size: " + String.format("%.0f", analysis.getStopIcebergResult().getEstimatedTotalSize()),
                analysis.getStopIcebergResult().getIcebergConfidence()));
        }
        
        // Large trade alerts
        if (analysis.getLargeTradeResult().isLargeTrade() && 
            analysis.getLargeTradeResult().getSignificance() > 80.0) {
            alerts.add(new TradingAlert("LARGE_TRADE", analysis.getSymbol(),
                "Large trade executed: " + analysis.getLargeTradeResult().getTradeType() + 
                " - Volume ratio: " + String.format("%.1fx", analysis.getLargeTradeResult().getVolumeRatio()),
                analysis.getLargeTradeResult().getSignificance()));
        }
        
        if (!alerts.isEmpty()) {
            activeAlerts.put(analysis.getSymbol(), alerts);
            alertsGenerated.addAndGet(alerts.size());
        }
    }
    
    public void initializeRealTimeProcessing() {
        // Start real-time processing tasks
        scheduler.scheduleAtFixedRate(this::processQueuedData, 100, 100, TimeUnit.MILLISECONDS);
        scheduler.scheduleAtFixedRate(this::cleanupOldData, 1, 1, TimeUnit.MINUTES);
        scheduler.scheduleAtFixedRate(this::updateStatistics, 5, 5, TimeUnit.SECONDS);
        
        System.out.println("🔄 Real-time order flow processing initialized");
    }
    
    private void processQueuedData() {
        // Process any queued data
    }
    
    private void cleanupOldData() {
        // Clean up old data to prevent memory leaks
        long cutoffTime = System.currentTimeMillis() - TimeUnit.HOURS.toMillis(1);
        
        activeAlerts.values().forEach(alerts -> 
            alerts.removeIf(alert -> alert.getTimestamp() < cutoffTime));
    }
    
    private void updateStatistics() {
        System.out.println(String.format("📊 [OrderFlowEngine] Processed: %d events, Patterns: %d, Alerts: %d",
            totalEventsProcessed.get(), patternsDetected.get(), alertsGenerated.get()));
    }
    
    // ==================== GETTERS FOR DASHBOARD ====================
    
    public Map<String, OrderFlowAnalysis> getCurrentAnalysis() {
        return new HashMap<>(currentAnalysis);
    }
    
    public Map<String, List<TradingAlert>> getActiveAlerts() {
        return new HashMap<>(activeAlerts);
    }
    
    public long getTotalEventsProcessed() {
        return totalEventsProcessed.get();
    }
    
    public long getPatternsDetected() {
        return patternsDetected.get();
    }
    
    public long getAlertsGenerated() {
        return alertsGenerated.get();
    }
    
