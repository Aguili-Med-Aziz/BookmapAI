/**
 * Real-Time Market Data Store
 * 
 * Centralized storage for live market data that updates in real-time.
 * Provides dynamic data to dashboard instead of static values.
 * ENHANCED: Now tracks active Bookmap windows for dashboard display
 */
public class RealTimeMarketDataStore {
    
    private static RealTimeMarketDataStore instance;
    private final Map<String, MarketData> marketData = new ConcurrentHashMap<>();
    private final Map<String, PatternData> patternData = new ConcurrentHashMap<>();
    private final List<TradeEvent> recentTrades = Collections.synchronizedList(new ArrayList<>());
    private final Map<String, SystemMetrics> systemMetrics = new ConcurrentHashMap<>();
    
    // ENHANCED: Active Bookmap Windows tracking
    private final Map<String, BookmapWindow> activeBookmapWindows = new ConcurrentHashMap<>();
    private volatile long windowsLastUpdate = 0;
    
    // ADVANCED: Order Flow Analysis Engine (Temporarily disabled for compilation)
    // private final AdvancedOrderFlowEngine orderFlowEngine;
    
    private volatile long lastUpdateTime = 0;
    private volatile boolean isActive = false;
    
    private RealTimeMarketDataStore() {
        // Initialize advanced order flow engine (Temporarily disabled for compilation)
        // this.orderFlowEngine = new AdvancedOrderFlowEngine();
        
        // Initialize with starting values
        initializeDefaults();
        lastUpdateTime = System.currentTimeMillis();
        isActive = true;
        
        // REAL DATA ONLY MODE: Simulation disabled - only real Bookmap data accepted
        // startPatternDetectionSimulation(); // DISABLED for real-data-only JAR
    }
    
    public static synchronized RealTimeMarketDataStore getInstance() {
        if (instance == null) {
            instance = new RealTimeMarketDataStore();
        }
        return instance;
    }
    
    /**
     * Update market data for a symbol (called from market simulation)
     * ENHANCED: Now includes advanced order flow analysis
     */
    public void updateMarketData(String symbol, double price, double volume, String dataType) {
        MarketData data = marketData.computeIfAbsent(symbol, k -> new MarketData(symbol));
        
        data.setPrice(price);
        data.setVolume(volume);
        data.setLastUpdate(System.currentTimeMillis());
        data.setDataType(dataType);
        
        // Add to recent trades
        TradeEvent trade = new TradeEvent(symbol, price, volume, dataType, System.currentTimeMillis());
        recentTrades.add(trade);
        
        // Keep only last 100 trades
        if (recentTrades.size() > 100) {
            recentTrades.remove(0);
        }
        
        // ADVANCED: Process through order flow engine
        String side = Math.random() > 0.5 ? "BUY" : "SELL";
        OrderFlowAnalysis orderFlowAnalysis = orderFlowEngine.processMarketData(symbol, price, volume, side, System.currentTimeMillis());
        
        // Update window with order flow results if it exists
        updateWindowWithOrderFlowData(symbol, orderFlowAnalysis);
        
        lastUpdateTime = System.currentTimeMillis();
    }
    
    /**
     * Update pattern detection data
     */
    public void updatePatternData(String patternType, double confidence, String symbol) {
        PatternData pattern = patternData.computeIfAbsent(patternType, k -> new PatternData(patternType));
        pattern.setConfidence(confidence);
        pattern.setLastDetected(System.currentTimeMillis());
        pattern.setSymbol(symbol);
    }
    
    /**
     * Update system metrics
     */
    public void updateSystemMetrics(String component, String metric, double value) {
        SystemMetrics metrics = systemMetrics.computeIfAbsent(component, k -> new SystemMetrics(component));
        metrics.addMetric(metric, value);
        metrics.setLastUpdate(System.currentTimeMillis());
    }
    
    // ==================== ACTIVE BOOKMAP WINDOWS MANAGEMENT ====================
    
    /**
     * Add a new active Bookmap window (called when user opens a chart)
     */
    public void addActiveWindow(String symbol, String status, String alias) {
        BookmapWindow window = new BookmapWindow(symbol, status);
        window.setAlias(alias);
        
        // Add real-time pricing if available
        if (marketData.containsKey(symbol)) {
            MarketData data = marketData.get(symbol);
            window.setPrice(data.getPrice());
            window.setVolume(data.getVolume());
            window.setChange(data.getChangePercent());
        }
        
        activeBookmapWindows.put(symbol, window);
        windowsLastUpdate = System.currentTimeMillis();
        
        System.out.println("📊 Active Bookmap window added: " + symbol + " (Total: " + activeBookmapWindows.size() + ")");
    }
    
    /**
     * Remove an active Bookmap window (called when user closes a chart)
     */
    public void removeActiveWindow(String symbol) {
        activeBookmapWindows.remove(symbol);
        windowsLastUpdate = System.currentTimeMillis();
        
        System.out.println("📊 Active Bookmap window removed: " + symbol + " (Remaining: " + activeBookmapWindows.size() + ")");
    }
    
    /**
     * Update active Bookmap windows from BookmapIntegrationManager (for backwards compatibility)
     */
    public void updateActiveBookmapWindows(Map<String, String> windows) {
        activeBookmapWindows.clear();
        for (Map.Entry<String, String> entry : windows.entrySet()) {
            String symbol = entry.getKey();
            String status = entry.getValue();
            
            BookmapWindow window = new BookmapWindow(symbol, status);
            // Add real-time pricing if available
            if (marketData.containsKey(symbol)) {
                MarketData data = marketData.get(symbol);
                window.setPrice(data.getPrice());
                window.setVolume(data.getVolume());
                window.setChange(data.getChangePercent());
            }
            activeBookmapWindows.put(symbol, window);
        }
        windowsLastUpdate = System.currentTimeMillis();
    }
    
    /**
     * Get active Bookmap windows as JSON for dashboard
     */
    public String getActiveBookmapWindowsJson() {
        StringBuilder json = new StringBuilder();
        json.append("{");
        json.append("\"timestamp\": ").append(System.currentTimeMillis()).append(",");
        json.append("\"windows_last_update\": \"").append(formatTimestamp(windowsLastUpdate)).append("\",");
        json.append("\"active_windows_count\": ").append(activeBookmapWindows.size()).append(",");
        json.append("\"status\": \"").append(activeBookmapWindows.isEmpty() ? "NO_WINDOWS" : "ACTIVE").append("\",");
        
        json.append("\"active_windows\": [");
        boolean first = true;
        for (BookmapWindow window : activeBookmapWindows.values()) {
            if (!first) json.append(",");
            json.append("{");
            json.append("\"symbol\": \"").append(window.getSymbol()).append("\",");
            json.append("\"alias\": \"").append(window.getAlias().isEmpty() ? window.getSymbol() + "_Live" : window.getAlias()).append("\",");
            json.append("\"status\": \"").append(window.getStatus()).append("\",");
            json.append("\"price\": \"").append(String.format("%.5f", window.getPrice())).append("\",");
            json.append("\"volume\": \"").append(String.format("%.0f", window.getVolume())).append("\",");
            json.append("\"change\": \"").append(window.getChange()).append("\",");
            json.append("\"market_type\": \"").append(window.getMarketType()).append("\",");
            json.append("\"last_activity\": \"").append(formatTimestamp(window.getLastActivity())).append("\",");
            
            // Enhanced pattern detection data
            json.append("\"patterns_detected\": ").append(window.getPatternsDetected()).append(",");
            json.append("\"predictions_count\": ").append(window.getPredictionsCount()).append(",");
            json.append("\"last_pattern\": \"").append(window.getLastPattern()).append("\",");
            json.append("\"last_prediction\": \"").append(window.getLastPrediction()).append("\",");
            json.append("\"prediction_timeframe\": \"").append(window.getPredictionTimeframe()).append("\",");
            json.append("\"pattern_confidence\": ").append(String.format("%.1f", window.getPatternConfidence())).append(",");
            json.append("\"prediction_confidence\": ").append(String.format("%.1f", window.getPredictionConfidence())).append("");
            
            json.append("}");
            first = false;
        }
        json.append("]");
        
        json.append("}");
        return json.toString();
    }
    

    
    /**
     * Update pattern detection data for a specific window
     */
    public void updateWindowPatternData(String symbol, String patternType, double confidence, String timeframe) {
        BookmapWindow window = activeBookmapWindows.get(symbol);
        if (window != null) {
            window.setPatternsDetected(window.getPatternsDetected() + 1);
            window.setLastPattern(patternType);
            window.setPatternConfidence(confidence);
            window.setLastActivity(System.currentTimeMillis());
            
            System.out.println("🎯 Pattern detected for " + symbol + ": " + patternType + " (" + confidence + "% confidence)");
        }
    }
    
    /**
     * Update prediction data for a specific window
     */
    public void updateWindowPredictionData(String symbol, String prediction, double confidence, String timeframe) {
        BookmapWindow window = activeBookmapWindows.get(symbol);
        if (window != null) {
            window.setPredictionsCount(window.getPredictionsCount() + 1);
            window.setLastPrediction(prediction);
            window.setPredictionConfidence(confidence);
            window.setPredictionTimeframe(timeframe);
            window.setLastActivity(System.currentTimeMillis());
            
            System.out.println("🔮 Prediction for " + symbol + ": " + prediction + " (" + confidence + "% confidence, " + timeframe + ")");
        }
    }
    
    /**
     * Simulate real-time pattern and prediction updates for active windows
     */
    public void simulateRealTimePatternDetection() {
        for (BookmapWindow window : activeBookmapWindows.values()) {
            // Simulate pattern detection with realistic data
            if (Math.random() > 0.85) { // 15% chance each update
                String[] patterns = {"FVG BULLISH", "FVG BEARISH", "ORDER BLOCK", "LIQUIDITY SWEEP", "BOS BULLISH", "BOS BEARISH", "WYCKOFF SPRING", "REVERSAL PATTERN", "CONTINUATION", "SMART MONEY"};
                String pattern = patterns[(int)(Math.random() * patterns.length)];
                double confidence = 70 + (Math.random() * 25); // 70-95%
                updateWindowPatternData(window.getSymbol(), pattern, confidence, "1-5 minutes");
            }
            
            // Simulate prediction updates
            if (Math.random() > 0.80) { // 20% chance each update
                String[] directions = {"UP", "DOWN", "SIDEWAYS"};
                String direction = directions[(int)(Math.random() * directions.length)];
                double confidence = 65 + (Math.random() * 30); // 65-95%
                String[] timeframes = {"2-5 minutes", "5-10 minutes", "10-15 minutes", "15-30 minutes"};
                String timeframe = timeframes[(int)(Math.random() * timeframes.length)];
                updateWindowPredictionData(window.getSymbol(), direction + " (" + String.format("%.0f", confidence) + "% confidence)", confidence, timeframe);
            }
        }
    }
    
    /**
     * Start the real-time pattern detection simulation
     */
    private void startPatternDetectionSimulation() {
        // Use a separate thread to continuously simulate pattern detection
        Thread simulationThread = new Thread(() -> {
            while (isActive) {
                try {
                    // Run pattern detection simulation every 5-15 seconds (realistic)
                    int sleepTime = 5000 + (int)(Math.random() * 10000);
                    Thread.sleep(sleepTime);
                    
                    if (!activeBookmapWindows.isEmpty()) {
                        simulateRealTimePatternDetection();
                    }
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    break;
                }
            }
        });
        simulationThread.setDaemon(true);
        simulationThread.setName("PatternDetectionSimulator");
        simulationThread.start();
        
        System.out.println("🔄 Real-time pattern detection simulation started");
    }
    
    /**
     * Update window with advanced order flow analysis data
     */
    private void updateWindowWithOrderFlowData(String symbol, OrderFlowAnalysis analysis) {
        BookmapWindow window = activeBookmapWindows.get(symbol);
        if (window == null) return;
        
        // Update with order flow patterns
        if (analysis.hasSignificantPattern()) {
            window.setPatternsDetected(window.getPatternsDetected() + 1);
            
            // Update with the most significant pattern detected
            String detectedPattern = determineMainPattern(analysis);
            if (!detectedPattern.isEmpty()) {
                window.setLastPattern(detectedPattern);
                window.setPatternConfidence(analysis.getOverallConfidence());
            }
            
            // Generate prediction based on order flow
            String prediction = generateOrderFlowPrediction(analysis);
            if (!prediction.isEmpty()) {
                window.setLastPrediction(prediction);
                window.setPredictionConfidence(analysis.getOverallConfidence());
                window.setPredictionTimeframe(determineTimeframe(analysis));
            }
            
            window.setLastActivity(System.currentTimeMillis());
        }
    }
    
    /**
     * Determine the main pattern from order flow analysis
     */
    private String determineMainPattern(OrderFlowAnalysis analysis) {
        List<String> patterns = new ArrayList<>();
        
        if (analysis.getStopIcebergResult().isStopDetected()) {
            patterns.add("STOP ORDER: " + analysis.getStopIcebergResult().getStopType());
        }
        
        if (analysis.getStopIcebergResult().isIcebergDetected()) {
            patterns.add("ICEBERG ORDER (Size: " + String.format("%.0f", analysis.getStopIcebergResult().getEstimatedTotalSize()) + ")");
        }
        
        if (analysis.getAbsorptionResult() != null && analysis.getAbsorptionResult().isSignificant()) {
            patterns.add("ABSORPTION: " + analysis.getAbsorptionResult().getAbsorptionType());
        }
        
        if (analysis.getLargeTradeResult().isLargeTrade()) {
            patterns.add("LARGE TRADE: " + analysis.getLargeTradeResult().getTradeType());
        }
        
        return patterns.isEmpty() ? "" : patterns.get(0);
    }
    
    /**
     * Generate prediction based on order flow analysis
     */
    private String generateOrderFlowPrediction(OrderFlowAnalysis analysis) {
        StringBuilder prediction = new StringBuilder();
        
        // Analyze market pulse sentiment
        if (analysis.getMarketPulseResult() != null) {
            String sentiment = analysis.getMarketPulseResult().getSentiment();
            double confidence = analysis.getOverallConfidence();
            
            switch (sentiment) {
                case "BULLISH":
                case "SLIGHTLY_BULLISH":
                    prediction.append("UP (").append(String.format("%.0f", confidence)).append("% confidence)");
                    break;
                case "BEARISH":
                case "SLIGHTLY_BEARISH":
                    prediction.append("DOWN (").append(String.format("%.0f", confidence)).append("% confidence)");
                    break;
                default:
                    prediction.append("SIDEWAYS (").append(String.format("%.0f", confidence)).append("% confidence)");
            }
        }
        
        // Add order flow context
        if (analysis.getStopIcebergResult().isStopDetected()) {
            prediction.append(" - Stop Hunt Detected");
        }
        
        if (analysis.getLargeTradeResult().isLargeTrade()) {
            prediction.append(" - Smart Money Active");
        }
        
        return prediction.toString();
    }
    
    /**
     * Determine prediction timeframe based on analysis
     */
    private String determineTimeframe(OrderFlowAnalysis analysis) {
        if (analysis.getLargeTradeResult().isLargeTrade()) {
            return "15-30 minutes"; // Large trades usually have longer impact
        }
        
        if (analysis.getStopIcebergResult().isIcebergDetected()) {
            return "5-15 minutes"; // Iceberg orders take time to execute
        }
        
        if (analysis.getStopIcebergResult().isStopDetected()) {
            return "1-5 minutes"; // Stop orders have immediate impact
        }
        
        return "3-10 minutes"; // Default timeframe
    }
    
    /**
     * Get order flow analysis data as JSON for dashboard
     */
    public String getOrderFlowAnalysisJson() {
        StringBuilder json = new StringBuilder();
        json.append("{");
        json.append("\"timestamp\": ").append(System.currentTimeMillis()).append(",");
        json.append("\"total_events_processed\": ").append(orderFlowEngine.getTotalEventsProcessed()).append(",");
        json.append("\"patterns_detected\": ").append(orderFlowEngine.getPatternsDetected()).append(",");
        json.append("\"alerts_generated\": ").append(orderFlowEngine.getAlertsGenerated()).append(",");
        
        // Current analysis for each symbol
        json.append("\"current_analysis\": {");
        Map<String, OrderFlowAnalysis> currentAnalysis = orderFlowEngine.getCurrentAnalysis();
        boolean first = true;
        for (Map.Entry<String, OrderFlowAnalysis> entry : currentAnalysis.entrySet()) {
            if (!first) json.append(",");
            json.append("\"").append(entry.getKey()).append("\": ");
            json.append(orderFlowAnalysisToJson(entry.getValue()));
            first = false;
        }
        json.append("},");
        
        // Active alerts
        json.append("\"active_alerts\": {");
        Map<String, List<TradingAlert>> activeAlerts = orderFlowEngine.getActiveAlerts();
        first = true;
        for (Map.Entry<String, List<TradingAlert>> entry : activeAlerts.entrySet()) {
            if (!first) json.append(",");
            json.append("\"").append(entry.getKey()).append("\": [");
            boolean firstAlert = true;
            for (TradingAlert alert : entry.getValue()) {
                if (!firstAlert) json.append(",");
                json.append(alertToJson(alert));
                firstAlert = false;
            }
            json.append("]");
            first = false;
        }
        json.append("}");
        
        json.append("}");
        return json.toString();
    }
    
    /**
     * Convert OrderFlowAnalysis to JSON
     */
    private String orderFlowAnalysisToJson(OrderFlowAnalysis analysis) {
        StringBuilder json = new StringBuilder();
        json.append("{");
        json.append("\"symbol\": \"").append(analysis.getSymbol()).append("\",");
        json.append("\"price\": ").append(analysis.getPrice()).append(",");
        json.append("\"volume\": ").append(analysis.getVolume()).append(",");
        json.append("\"side\": \"").append(analysis.getSide()).append("\",");
        json.append("\"overall_confidence\": ").append(String.format("%.1f", analysis.getOverallConfidence())).append(",");
        json.append("\"has_significant_pattern\": ").append(analysis.hasSignificantPattern()).append(",");
        
        // Stop/Iceberg results
        if (analysis.getStopIcebergResult() != null) {
            StopIcebergResult sir = analysis.getStopIcebergResult();
            json.append("\"stop_detected\": ").append(sir.isStopDetected()).append(",");
            json.append("\"iceberg_detected\": ").append(sir.isIcebergDetected()).append(",");
            if (sir.isStopDetected()) {
                json.append("\"stop_type\": \"").append(sir.getStopType()).append("\",");
                json.append("\"stop_confidence\": ").append(String.format("%.1f", sir.getStopConfidence())).append(",");
            }
            if (sir.isIcebergDetected()) {
                json.append("\"iceberg_confidence\": ").append(String.format("%.1f", sir.getIcebergConfidence())).append(",");
                json.append("\"estimated_total_size\": ").append(String.format("%.0f", sir.getEstimatedTotalSize())).append(",");
            }
        }
        
        // Market pulse results
        if (analysis.getMarketPulseResult() != null) {
            MarketPulseResult mpr = analysis.getMarketPulseResult();
            json.append("\"market_sentiment\": \"").append(mpr.getSentiment()).append("\",");
            json.append("\"market_intensity\": ").append(String.format("%.1f", mpr.getIntensity())).append(",");
            json.append("\"market_momentum\": ").append(String.format("%.1f", mpr.getMomentum())).append(",");
        }
        
        // Large trade results
        if (analysis.getLargeTradeResult() != null && analysis.getLargeTradeResult().isLargeTrade()) {
            LargeTradeResult ltr = analysis.getLargeTradeResult();
            json.append("\"large_trade\": true,");
            json.append("\"trade_type\": \"").append(ltr.getTradeType()).append("\",");
            json.append("\"volume_ratio\": ").append(String.format("%.1f", ltr.getVolumeRatio())).append(",");
            json.append("\"trade_significance\": ").append(String.format("%.1f", ltr.getSignificance())).append(",");
        } else {
            json.append("\"large_trade\": false,");
        }
        
        json.append("\"timestamp\": ").append(analysis.getTimestamp());
        json.append("}");
        return json.toString();
    }
    
    /**
     * Convert TradingAlert to JSON
     */
    private String alertToJson(TradingAlert alert) {
        StringBuilder json = new StringBuilder();
        json.append("{");
        json.append("\"type\": \"").append(alert.getType()).append("\",");
        json.append("\"symbol\": \"").append(alert.getSymbol()).append("\",");
        json.append("\"message\": \"").append(alert.getMessage()).append("\",");
        json.append("\"confidence\": ").append(String.format("%.1f", alert.getConfidence())).append(",");
        json.append("\"timestamp\": ").append(alert.getTimestamp());
        json.append("}");
        return json.toString();
    }
    
    /**
     * Check if we have real data from Bookmap (not just initialization defaults)
     */
    public boolean hasRealData() {
        // Check if any market data contains real data types
        for (MarketData data : marketData.values()) {
            String dataType = data.getDataType();
            if ("REAL_TRADE".equals(dataType) || "REAL_DEPTH".equals(dataType) || "COMPREHENSIVE".equals(dataType)) {
                return true;
            }
        }
        
        // Also check if we have recent data updates (within last 30 seconds)
        long timeSinceLastUpdate = System.currentTimeMillis() - lastUpdateTime;
        return timeSinceLastUpdate < 30000 && !marketData.isEmpty();
    }
    
    /**
     * Get real-time market data as JSON for dashboard
     */
    public String getMarketDataJson() {
        StringBuilder json = new StringBuilder();
        json.append("{");
