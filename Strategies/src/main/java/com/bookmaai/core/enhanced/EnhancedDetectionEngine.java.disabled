    // ==================== ENHANCED ICEBERG DETECTION ====================
    
    /**
     * Multi-Stage Iceberg Order Detection
     * Target: 95% accuracy with sub-millisecond processing
     */
    public static class EnhancedIcebergDetector {
        
        private final Map<String, IcebergAnalysisState> analysisStates = new ConcurrentHashMap<>();
        private final Map<String, List<OrderExecutionData>> executionHistory = new ConcurrentHashMap<>();
        
        public IcebergDetectionResult analyzeIcebergPattern(String symbol, double price, double volume, 
                                                           Map<String, Double> orderBookData, long timestamp) {
            
            IcebergDetectionResult result = new IcebergDetectionResult(symbol, price, volume, timestamp);
            IcebergAnalysisState state = analysisStates.computeIfAbsent(symbol, k -> new IcebergAnalysisState());
            
            // Stage 1: Volume Pattern Analysis
            VolumePatternAnalysis volumeAnalysis = analyzeVolumePatterns(symbol, volume, state);
            result.setVolumePatternAnalysis(volumeAnalysis);
            
            // Stage 2: Refill Pattern Detection  
            RefillPatternAnalysis refillAnalysis = analyzeRefillPatterns(symbol, price, volume, state);
            result.setRefillPatternAnalysis(refillAnalysis);
            
            // Stage 3: Time-Based Consistency Analysis
            TimeConsistencyAnalysis timeAnalysis = analyzeTimeConsistency(symbol, timestamp, state);
            result.setTimeConsistencyAnalysis(timeAnalysis);
            
            // Stage 4: Hidden vs Visible Size Estimation
            HiddenSizeAnalysis hiddenAnalysis = estimateHiddenSize(symbol, volume, orderBookData, state);
            result.setHiddenSizeAnalysis(hiddenAnalysis);
            
            // Stage 5: Statistical Significance Testing
            StatisticalSignificance significance = calculateStatisticalSignificance(volumeAnalysis, refillAnalysis, 
                                                                                   timeAnalysis, hiddenAnalysis);
            result.setStatisticalSignificance(significance);
            
            // Final Confidence Calculation
            double confidence = calculateIcebergConfidence(volumeAnalysis, refillAnalysis, timeAnalysis, 
                                                         hiddenAnalysis, significance);
            result.setConfidence(confidence);
            result.setDetected(confidence >= ICEBERG_CONFIDENCE_THRESHOLD);
            
            // Update state
            state.updateWithExecution(price, volume, timestamp);
            
            return result;
        }
        
        private VolumePatternAnalysis analyzeVolumePatterns(String symbol, double volume, IcebergAnalysisState state) {
            VolumePatternAnalysis analysis = new VolumePatternAnalysis();
            
            // Consistent Volume Size Detection
            double volumeConsistency = calculateVolumeConsistency(state.getRecentVolumes(), volume);
            analysis.setVolumeConsistency(volumeConsistency);
            
            // Volume Size Distribution Analysis
            double averageVolume = state.getAverageVolume();
            double volumeRatio = averageVolume > 0 ? volume / averageVolume : 1.0;
            analysis.setVolumeRatio(volumeRatio);
            
            // Repetition Pattern Score
            double repetitionScore = calculateRepetitionScore(state.getRecentVolumes());
            analysis.setRepetitionScore(repetitionScore);
            
            // Pattern Strength (0-100)
            double patternStrength = (volumeConsistency * 0.4) + (Math.min(1.0, volumeRatio) * 0.3) + 
                                   (repetitionScore * 0.3);
            analysis.setPatternStrength(patternStrength * 100);
            
            return analysis;
        }
        
        private RefillPatternAnalysis analyzeRefillPatterns(String symbol, double price, double volume, 
                                                          IcebergAnalysisState state) {
            RefillPatternAnalysis analysis = new RefillPatternAnalysis();
            
            // Check for consistent refills at same price level
            int refillCount = state.countRefillsAtPrice(price, volume);
            analysis.setRefillCount(refillCount);
            
            // Refill timing consistency
            double timingConsistency = calculateRefillTimingConsistency(state.getRefillTimings(price));
            analysis.setTimingConsistency(timingConsistency);
            
            // Refill size consistency  
            double sizeConsistency = calculateRefillSizeConsistency(state.getRefillSizes(price), volume);
            analysis.setSizeConsistency(sizeConsistency);
            
            // Overall refill pattern score
            double refillScore = (refillCount * 0.2) + (timingConsistency * 0.4) + (sizeConsistency * 0.4);
            analysis.setRefillScore(Math.min(100.0, refillScore * 20));
            
            return analysis;
        }
        
        private TimeConsistencyAnalysis analyzeTimeConsistency(String symbol, long timestamp, 
                                                             IcebergAnalysisState state) {
            TimeConsistencyAnalysis analysis = new TimeConsistencyAnalysis();
            
            List<Long> recentTimestamps = state.getRecentTimestamps();
            if (recentTimestamps.size() < 3) {
                analysis.setTimeConsistency(0.0);
                analysis.setExecutionRhythm(0.0);
                return analysis;
            }
            
            // Calculate time intervals between executions
            List<Long> intervals = new ArrayList<>();
            for (int i = 1; i < recentTimestamps.size(); i++) {
                intervals.add(recentTimestamps.get(i) - recentTimestamps.get(i-1));
            }
            
            // Time consistency score
            double timeConsistency = calculateTimeConsistency(intervals);
            analysis.setTimeConsistency(timeConsistency);
            
            // Execution rhythm (regularity of intervals)
            double executionRhythm = calculateExecutionRhythm(intervals);
            analysis.setExecutionRhythm(executionRhythm);
            
            // Pattern maturity (how long pattern has been consistent)
            double maturity = Math.min(1.0, recentTimestamps.size() / 20.0);
            analysis.setPatternMaturity(maturity);
            
            return analysis;
        }
        
        private HiddenSizeAnalysis estimateHiddenSize(String symbol, double volume, 
                                                    Map<String, Double> orderBookData, 
                                                    IcebergAnalysisState state) {
            HiddenSizeAnalysis analysis = new HiddenSizeAnalysis();
            
            double visibleSize = volume;
            double marketDepth = orderBookData.getOrDefault("MarketDepth", 1000.0);
            double avgTradeSize = orderBookData.getOrDefault("AvgTradeSize", 100.0);
            
            // Estimate total iceberg size based on execution pattern
            double estimatedTotalSize = estimateIcebergTotalSize(state, visibleSize, marketDepth);
            analysis.setEstimatedTotalSize(estimatedTotalSize);
            
            // Hidden vs visible ratio
            double hiddenRatio = (estimatedTotalSize - visibleSize) / estimatedTotalSize;
            analysis.setHiddenRatio(hiddenRatio);
            
            // Execution efficiency (how well hidden the iceberg is)
            double efficiency = calculateIcebergEfficiency(visibleSize, avgTradeSize, state);
            analysis.setExecutionEfficiency(efficiency);
            
            return analysis;
        }
        
        private StatisticalSignificance calculateStatisticalSignificance(VolumePatternAnalysis volume,
                                                                        RefillPatternAnalysis refill,
                                                                        TimeConsistencyAnalysis time,
                                                                        HiddenSizeAnalysis hidden) {
            StatisticalSignificance significance = new StatisticalSignificance();
            
            // Chi-square test for volume distribution
            double volumeChiSquare = calculateChiSquareTest(volume.getPatternStrength());
            significance.setVolumeChiSquare(volumeChiSquare);
            
            // P-value for pattern significance
            double pValue = calculatePValue(volume.getPatternStrength(), refill.getRefillScore(), 
                                          time.getTimeConsistency());
            significance.setPValue(pValue);
            
            // Overall statistical confidence
            double statConfidence = (volumeChiSquare * 0.3) + ((1.0 - pValue) * 0.4) + 
                                   (hidden.getExecutionEfficiency() * 0.3);
            significance.setStatisticalConfidence(statConfidence);
            
            return significance;
        }
        
        private double calculateIcebergConfidence(VolumePatternAnalysis volume, RefillPatternAnalysis refill,
                                                TimeConsistencyAnalysis time, HiddenSizeAnalysis hidden,
                                                StatisticalSignificance significance) {
            
            // Weighted confidence calculation based on research
            double volumeWeight = 0.25;
            double refillWeight = 0.30;
            double timeWeight = 0.20;
            double hiddenWeight = 0.15;
            double statWeight = 0.10;
            
            return (volume.getPatternStrength() / 100.0 * volumeWeight) +
                   (refill.getRefillScore() / 100.0 * refillWeight) +
                   (time.getTimeConsistency() * timeWeight) +
                   (hidden.getExecutionEfficiency() * hiddenWeight) +
                   (significance.getStatisticalConfidence() * statWeight);
        }
        
        // Helper Methods
        private double calculateVolumeConsistency(List<Double> volumes, double newVolume) {
            if (volumes.isEmpty()) return 0.0;
            
            double mean = volumes.stream().mapToDouble(Double::doubleValue).average().orElse(0.0);
            double variance = volumes.stream()
                .mapToDouble(v -> Math.pow(v - mean, 2))
                .average().orElse(0.0);
            double stdDev = Math.sqrt(variance);
            
            if (stdDev == 0) return 1.0; // Perfect consistency
            
            double zScore = Math.abs(newVolume - mean) / stdDev;
            return Math.max(0.0, 1.0 - (zScore / 3.0)); // Normalize to 0-1
        }
        
        private double calculateRepetitionScore(List<Double> volumes) {
            if (volumes.size() < 3) return 0.0;
            
            Map<Double, Integer> volumeCounts = new HashMap<>();
            for (Double volume : volumes) {
                volumeCounts.merge(volume, 1, Integer::sum);
            }
            
            int maxCount = volumeCounts.values().stream().mapToInt(Integer::intValue).max().orElse(1);
            return Math.min(1.0, maxCount / 10.0); // Max score at 10 repetitions
        }
        
        private double calculateRefillTimingConsistency(List<Long> timings) {
            if (timings.size() < 2) return 0.0;
            
            List<Long> intervals = new ArrayList<>();
            for (int i = 1; i < timings.size(); i++) {
                intervals.add(timings.get(i) - timings.get(i-1));
            }
            
            double mean = intervals.stream().mapToLong(Long::longValue).average().orElse(0.0);
            double variance = intervals.stream()
                .mapToDouble(interval -> Math.pow(interval - mean, 2))
                .average().orElse(0.0);
            
            double cv = variance > 0 ? Math.sqrt(variance) / mean : 0.0; // Coefficient of variation
            return Math.max(0.0, 1.0 - cv); // Lower CV = higher consistency
        }
        
        private double calculateRefillSizeConsistency(List<Double> sizes, double newSize) {
            if (sizes.isEmpty()) return 0.0;
            
            double mean = sizes.stream().mapToDouble(Double::doubleValue).average().orElse(0.0);
            if (mean == 0) return 0.0;
            
            double deviationPercentage = Math.abs(newSize - mean) / mean;
            return Math.max(0.0, 1.0 - deviationPercentage); // Lower deviation = higher consistency
        }
        
        private double calculateTimeConsistency(List<Long> intervals) {
            if (intervals.size() < 2) return 0.0;
            
            double mean = intervals.stream().mapToLong(Long::longValue).average().orElse(0.0);
            double variance = intervals.stream()
                .mapToDouble(interval -> Math.pow(interval - mean, 2))
                .average().orElse(0.0);
            
            double cv = variance > 0 ? Math.sqrt(variance) / mean : 0.0;
            return Math.max(0.0, 1.0 - cv);
        }
        
        private double calculateExecutionRhythm(List<Long> intervals) {
            // Implementation for rhythm calculation
            return calculateTimeConsistency(intervals) * 0.8; // Simplified
        }
        
        private double estimateIcebergTotalSize(IcebergAnalysisState state, double visibleSize, double marketDepth) {
            double executionCount = state.getExecutionCount();
            double avgExecutionSize = state.getAverageVolume();
            
            // Estimate based on execution pattern and market conditions
            double multiplier = 5.0 + (executionCount * 0.5) + (marketDepth / 10000.0);
            return visibleSize * Math.min(20.0, multiplier);
        }
        
        private double calculateIcebergEfficiency(double visibleSize, double avgTradeSize, IcebergAnalysisState state) {
            // How well the iceberg is hidden (smaller visible chunks = more efficient)
            double sizeRatio = visibleSize / avgTradeSize;
            double consistencyBonus = state.getVolumeConsistency();
            
            return Math.min(1.0, (1.0 / sizeRatio) + (consistencyBonus * 0.3));
        }
        
        private double calculateChiSquareTest(double patternStrength) {
            // Simplified chi-square calculation
            return Math.min(1.0, patternStrength / 100.0 * 0.95);
        }
        
        private double calculatePValue(double volumeStrength, double refillScore, double timeConsistency) {
            double combinedScore = (volumeStrength + refillScore + timeConsistency * 100) / 3.0;
            return Math.max(0.001, 1.0 - (combinedScore / 100.0));
        }
    }
    
    // ==================== SUPPORTING CLASSES ====================
    
    public static class IcebergAnalysisState {
        private final List<Double> recentVolumes = new ArrayList<>();
        private final List<Long> recentTimestamps = new ArrayList<>();
        private final Map<Double, List<Double>> refillSizesByPrice = new HashMap<>();
        private final Map<Double, List<Long>> refillTimingsByPrice = new HashMap<>();
        private int executionCount = 0;
        
        public void updateWithExecution(double price, double volume, long timestamp) {
            recentVolumes.add(volume);
            recentTimestamps.add(timestamp);
            
            // Keep only recent data (last 50 executions)
            if (recentVolumes.size() > 50) {
                recentVolumes.remove(0);
                recentTimestamps.remove(0);
            }
            
            // Track refills by price level
            refillSizesByPrice.computeIfAbsent(price, k -> new ArrayList<>()).add(volume);
            refillTimingsByPrice.computeIfAbsent(price, k -> new ArrayList<>()).add(timestamp);
            
            executionCount++;
        }
        
        public List<Double> getRecentVolumes() { return new ArrayList<>(recentVolumes); }
        public List<Long> getRecentTimestamps() { return new ArrayList<>(recentTimestamps); }
        
        public double getAverageVolume() {
            return recentVolumes.stream().mapToDouble(Double::doubleValue).average().orElse(0.0);
        }
        
        public int countRefillsAtPrice(double price, double volume) {
            List<Double> sizes = refillSizesByPrice.get(price);
            if (sizes == null) return 0;
            
            long matches = sizes.stream().mapToLong(size -> 
                Math.abs(size - volume) < (volume * 0.05) ? 1 : 0).sum(); // 5% tolerance
            return (int) matches;
        }
        
        public List<Long> getRefillTimings(double price) {
            return refillTimingsByPrice.getOrDefault(price, new ArrayList<>());
        }
        
        public List<Double> getRefillSizes(double price) {
            return refillSizesByPrice.getOrDefault(price, new ArrayList<>());
        }
        
        public double getVolumeConsistency() {
            if (recentVolumes.size() < 3) return 0.0;
            
            double mean = getAverageVolume();
            double variance = recentVolumes.stream()
                .mapToDouble(v -> Math.pow(v - mean, 2))
                .average().orElse(0.0);
            double stdDev = Math.sqrt(variance);
            
            return stdDev == 0 ? 1.0 : Math.max(0.0, 1.0 - (stdDev / mean));
        }
        
        public int getExecutionCount() { return executionCount; }
    }
    
