    // ==================== BASE DETECTION RESULT ====================
    
    public abstract static class DetectionResult {
        protected final String symbol;
        protected final double price;
        protected final long timestamp;
        protected double confidence;
        protected boolean detected;
        
        public DetectionResult(String symbol, double price, long timestamp) {
            this.symbol = symbol;
            this.price = price;
            this.timestamp = timestamp;
        }
        
        public String getSymbol() { return symbol; }
        public double getPrice() { return price; }
        public long getTimestamp() { return timestamp; }
        public double getConfidence() { return confidence; }
        public boolean isDetected() { return detected; }
        
        public abstract String getDetectionType();
    }
    
    // ==================== ENHANCED DETECTION RESULT ====================
    
    public static class EnhancedDetectionResult extends DetectionResult {
        private IcebergDetectionResult icebergResult;
        private AbsorptionAnalysisResult absorptionResult;
        private MarketImbalanceResult imbalanceResult;
        private CompositeSignalResult compositeResult;
        
        public EnhancedDetectionResult(String symbol, double price, long timestamp) {
            super(symbol, price, timestamp);
        }
        
        @Override
        public String getDetectionType() {
            return "Enhanced Multi-Pattern Detection";
        }
        
        // Getters and setters
        public IcebergDetectionResult getIcebergResult() { return icebergResult; }
        public void setIcebergResult(IcebergDetectionResult icebergResult) { this.icebergResult = icebergResult; }
        
        public AbsorptionAnalysisResult getAbsorptionResult() { return absorptionResult; }
        public void setAbsorptionResult(AbsorptionAnalysisResult absorptionResult) { this.absorptionResult = absorptionResult; }
        
        public MarketImbalanceResult getImbalanceResult() { return imbalanceResult; }
        public void setImbalanceResult(MarketImbalanceResult imbalanceResult) { this.imbalanceResult = imbalanceResult; }
        
        public CompositeSignalResult getCompositeResult() { return compositeResult; }
        public void setCompositeResult(CompositeSignalResult compositeResult) { this.compositeResult = compositeResult; }
        
        public boolean hasAnyDetection() {
            return (icebergResult != null && icebergResult.isDetected()) ||
                   (absorptionResult != null && absorptionResult.isAbsorptionDetected()) ||
                   (imbalanceResult != null && imbalanceResult.isImbalanceDetected());
        }
        
        public double getOverallConfidence() {
            if (compositeResult != null) {
                return compositeResult.getCompositeSignalDecision().getFinalConfidence();
            }
            
            double totalConfidence = 0.0;
            int count = 0;
            
            if (icebergResult != null && icebergResult.isDetected()) {
                totalConfidence += icebergResult.getConfidence();
                count++;
            }
            if (absorptionResult != null && absorptionResult.isAbsorptionDetected()) {
                totalConfidence += absorptionResult.getConfidence();
                count++;
            }
            if (imbalanceResult != null && imbalanceResult.isImbalanceDetected()) {
                totalConfidence += imbalanceResult.getOverallConfidence();
                count++;
            }
            
            return count > 0 ? totalConfidence / count : 0.0;
        }
    }
    
    // ==================== MAIN PROCESSING METHODS ====================
    
    /**
     * Comprehensive Market Data Processing
     * Processes market data through all enhanced detection engines
     */
    public CompletableFuture<EnhancedDetectionResult> processEnhancedMarketData(String symbol, double price, 
                                                                              double volume, double bidVolume, 
                                                                              double askVolume, 
                                                                              Map<String, Double> orderBookData,
                                                                              Map<String, Double> volumeData) {
        return CompletableFuture.supplyAsync(() -> {
            totalDetections.incrementAndGet();
            long timestamp = System.currentTimeMillis();
            
            EnhancedDetectionResult result = new EnhancedDetectionResult(symbol, price, timestamp);
            
            try {
                // Stage 1: Enhanced Iceberg Detection
                CompletableFuture<IcebergDetectionResult> icebergFuture = CompletableFuture.supplyAsync(() ->
                    icebergDetector.analyzeIcebergPattern(symbol, price, volume, orderBookData, timestamp), processingPool);
                
                // Stage 2: Advanced Absorption Analysis
                CompletableFuture<AbsorptionAnalysisResult> absorptionFuture = CompletableFuture.supplyAsync(() ->
                    absorptionAnalyzer.analyzeAbsorptionPattern(symbol, price, bidVolume, askVolume, orderBookData, timestamp), processingPool);
                
                // Stage 3: Market Imbalance Detection
                CompletableFuture<MarketImbalanceResult> imbalanceFuture = CompletableFuture.supplyAsync(() ->
                    imbalanceEngine.analyzeMarketImbalance(symbol, price, orderBookData, volumeData, timestamp), processingPool);
                
                // Wait for all detections to complete
                IcebergDetectionResult icebergResult = icebergFuture.get(200, TimeUnit.MILLISECONDS);
                AbsorptionAnalysisResult absorptionResult = absorptionFuture.get(200, TimeUnit.MILLISECONDS);
                MarketImbalanceResult imbalanceResult = imbalanceFuture.get(200, TimeUnit.MILLISECONDS);
                
                // Set individual results
                result.setIcebergResult(icebergResult);
                result.setAbsorptionResult(absorptionResult);
                result.setImbalanceResult(imbalanceResult);
                
                // Stage 4: Composite Signal Generation
                if (icebergResult != null || absorptionResult != null || imbalanceResult != null) {
                    CompositeSignalResult compositeResult = compositeProcessor.generateCompositeSignal(
                        symbol, price, icebergResult, absorptionResult, imbalanceResult, timestamp);
                    result.setCompositeResult(compositeResult);
                    
                    if (compositeResult.getCompositeSignalDecision().getSignalStrength() != CompositeSignalStrength.NONE) {
                        compositeSignals.incrementAndGet();
                    }
                }
                
                // Update detection counters
                if (icebergResult != null && icebergResult.isDetected()) {
                    icebergDetections.incrementAndGet();
                }
                if (absorptionResult != null && absorptionResult.isAbsorptionDetected()) {
                    absorptionDetections.incrementAndGet();
                }
                if (imbalanceResult != null && imbalanceResult.isImbalanceDetected()) {
                    imbalanceDetections.incrementAndGet();
                }
                
                // Set overall result properties
                result.detected = result.hasAnyDetection();
                result.confidence = result.getOverallConfidence();
                
                // Store recent detections
                recentDetections.computeIfAbsent(symbol, k -> new CopyOnWriteArrayList<>()).add(result);
                
                // Keep only recent detections (last 100)
                List<DetectionResult> symbolDetections = recentDetections.get(symbol);
                if (symbolDetections.size() > 100) {
                    symbolDetections.remove(0);
                }
                
            } catch (Exception e) {
                System.err.println("Error in enhanced detection processing: " + e.getMessage());
                e.printStackTrace();
            }
            
            return result;
        }, processingPool);
    }
    
    /**
     * Legacy method for backward compatibility
     */
    public CompletableFuture<List<DetectionResult>> processMarketData(String symbol, double price, 
                                                                     double volume, Map<String, Double> orderBookData) {
        // Create default volume data
        Map<String, Double> volumeData = new HashMap<>();
        volumeData.put("BuyVolume", volume * 0.6);
        volumeData.put("SellVolume", volume * 0.4);
        
        return processEnhancedMarketData(symbol, price, volume, volume * 0.6, volume * 0.4, 
                                       orderBookData, volumeData)
            .thenApply(result -> {
                List<DetectionResult> results = new ArrayList<>();
                results.add(result);
                return results;
            });
    }
    
    private void initializeRealTimeProcessing() {
        scheduler.scheduleAtFixedRate(this::updateStatistics, 10, 10, TimeUnit.SECONDS);
        scheduler.scheduleAtFixedRate(this::cleanupOldData, 5, 5, TimeUnit.MINUTES);
        System.out.println("🔄 Enhanced detection real-time processing initialized");
    }
    
    private void updateStatistics() {
        System.out.println(String.format("📊 [EnhancedDetection] Total: %d, Iceberg: %d, Absorption: %d, Imbalance: %d, Composite: %d",
            totalDetections.get(), icebergDetections.get(), absorptionDetections.get(), 
            imbalanceDetections.get(), compositeSignals.get()));
    }
    
    private void cleanupOldData() {
        long cutoffTime = System.currentTimeMillis() - TimeUnit.HOURS.toMillis(2);
        
        recentDetections.values().forEach(detections -> 
            detections.removeIf(detection -> detection instanceof IcebergDetectionResult && 
                              ((IcebergDetectionResult) detection).getTimestamp() < cutoffTime));
    }
    
    // ==================== GETTERS ====================
    
    public Map<String, List<DetectionResult>> getRecentDetections() {
        return new HashMap<>(recentDetections);
    }
    
    public long getTotalDetections() { return totalDetections.get(); }
    public long getIcebergDetections() { return icebergDetections.get(); }
    public long getAbsorptionDetections() { return absorptionDetections.get(); }
    public long getImbalanceDetections() { return imbalanceDetections.get(); }
    public long getCompositeSignals() { return compositeSignals.get(); }
}