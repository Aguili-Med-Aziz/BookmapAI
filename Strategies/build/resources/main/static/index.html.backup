            // Display demo sessions in main container
            displayMainActiveSessions(demoSessions);
            
            // Update counters to show demo data
            updateElementWithColor('main-active-sessions-count', demoSessions.length, 'main-active-sessions-count');
            
            // Update status
            const statusElement = document.getElementById('main-sessions-status');
            if (statusElement) {
                statusElement.innerHTML = '<span style="color: #f39c12;">🟡 DEMO MODE - Showing Example Sessions</span>';
            }
            
            // Add demo banner to main container
            const container = document.getElementById('main-active-sessions-container');
            if (container) {
                const demoBanner = document.createElement('div');
                demoBanner.id = 'main-demo-banner';
                demoBanner.innerHTML = `
                    <div style="background: linear-gradient(135deg, #f39c12, #e67e22); color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center; box-shadow: 0 4px 8px rgba(243, 156, 18, 0.3);">
                        <h4 style="margin: 0 0 10px 0;"><i class="fas fa-star"></i> 🎯 DEMO SESSION PREVIEW</h4>
                        <p style="margin: 0; font-size: 0.9em;">This shows exactly what your individual session panels will look like with real Bookmap data!</p>
                        <div style="margin-top: 10px;">
                            <button onclick="clearMainDemoSessions()" style="background: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.3); padding: 8px 16px; border-radius: 20px; cursor: pointer; font-size: 0.9em;">
                                <i class="fas fa-times"></i> Clear Demo
                            </button>
                        </div>
                    </div>
                `;
                container.insertBefore(demoBanner, container.firstChild);
            }
            
            console.log('🎯 Main demo sessions displayed - showing example in dedicated section');
        }
        
        function displayMainActiveSessions(sessions) {
            const container = document.getElementById('main-active-sessions-container');
            if (!container) return;
            
            let html = '';
            
            sessions.forEach(session => {
                html += createSessionPanel(session);
            });
            
            container.innerHTML = html;
            
            // Start real-time updates for each session
            sessions.forEach(session => {
                startSessionRealTimeUpdates(session.session_id);
            });
        }
        
        function clearMainDemoSessions() {
            // Clear main demo session protection flag
            mainDemoSessionsActive = false;
            
            // Remove demo banner
            const demoBanner = document.getElementById('main-demo-banner');
            if (demoBanner) {
                demoBanner.remove();
            }
            
            // Clear main sessions and show no sessions message
            clearMainActiveSessions();
            showMainNoSessionsMessage();
            
            // Reset counters
            updateElementWithColor('main-active-sessions-count', '0', 'main-active-sessions-count');
            
            // Reset status
            const statusElement = document.getElementById('main-sessions-status');
            if (statusElement) {
                statusElement.innerHTML = '<span style="color: #f39c12;">🟡 No Active Sessions - Open Bookmap Charts</span>';
            }
            
            console.log('🧹 Main demo sessions cleared - back to waiting for real data');
        }
        
        function hideMainNoSessionsMessage() {
            const messageElement = document.getElementById('main-no-sessions-message');
            if (messageElement) {
                messageElement.style.display = 'none';
            }
        }
        
        function showMainNoSessionsMessage() {
            const messageElement = document.getElementById('main-no-sessions-message');
            if (messageElement) {
                messageElement.style.display = 'block';
            }
        }
        
        function clearMainActiveSessions() {
            const container = document.getElementById('main-active-sessions-container');
            if (container) {
                container.innerHTML = '';
            }
        }
        
        /**
         * Helper: Get market type color
         */
        function getMarketTypeColor(marketType) {
            switch(marketType) {
                case 'FOREX': return '#4fc3f7';
                case 'CRYPTO': return '#ff9800';
                case 'FUTURES': return '#4caf50';
                case 'COMMODITIES': return '#9c27b0';
                default: return '#607d8b';
            }
        }
        
        /**
         * Helper: Get change color based on positive/negative
         */
        function getChangeColor(change) {
            const numChange = parseFloat(change);
            return numChange >= 0 ? '#4caf50' : '#f44336';
        }
        
        /**
         * Helper: Format timestamp for display
         */
        function formatTimestamp(timestamp) {
            if (timestamp === 'Never' || !timestamp) return 'Never';
            
            try {
                const date = new Date(timestamp);
                return date.toLocaleTimeString();
            } catch (e) {
                return timestamp;
            }
        }
        
        /**
         * Update data source indicator to show if we're getting real vs. fallback data
         */
        function updateDataSourceIndicator(data) {
            const indicatorElement = document.getElementById('data-source-indicator');
            if (!indicatorElement) {
                // Create indicator if it doesn't exist
                const headerStats = document.querySelector('.header-stats');
                if (headerStats) {
                    const indicator = document.createElement('div');
                    indicator.id = 'data-source-indicator';
                    indicator.className = 'stat-item';
                    indicator.innerHTML = '<span class="stat-value" id="data-source-value">---</span><span class="stat-label">Data Source</span>';
                    headerStats.appendChild(indicator);
                }
                return;
            }
            
            const valueElement = document.getElementById('data-source-value');
            const dataSource = data.data_source || 'UNKNOWN';
            const systemMode = data.system_mode || 'UNKNOWN';
            const realDataConnection = data.real_data_connection;
            
            if (systemMode === 'REAL_DATA' || realDataConnection === true) {
                valueElement.textContent = '🟢 REAL';
                valueElement.style.color = '#4caf50';
                valueElement.title = 'Receiving real data from Bookmap';
            } else if (dataSource === 'FALLBACK') {
                valueElement.textContent = '🟡 FALLBACK';
                valueElement.style.color = '#ff9800';
                valueElement.title = 'Using fallback data - no real Bookmap connection';
            } else if (dataSource === 'ERROR') {
                valueElement.textContent = '🔴 ERROR';
                valueElement.style.color = '#f44336';
                valueElement.title = 'Error getting data: ' + (data.error || 'Unknown error');
            } else {
                valueElement.textContent = '🟡 INIT';
                valueElement.style.color = '#ff9800';
                valueElement.title = 'Initializing - waiting for real Bookmap data';
            }
        }
        
        /**
         * Update market data source indicator  
         */
        function updateMarketDataSourceIndicator(data) {
            // Add market data status to alerts container
            const alertsContainer = document.getElementById('alerts-container');
            if (alertsContainer) {
                // Remove old market data status alerts
                const oldAlerts = alertsContainer.querySelectorAll('.market-data-status-alert');
                oldAlerts.forEach(alert => alert.remove());
                
                // Add new market data status alert
                const alertDiv = document.createElement('div');
                alertDiv.className = 'market-data-status-alert';
                
                const dataSource = data.data_source || 'LIVE';
                const hasRealData = data.active_symbols && data.active_symbols.some(symbol => 
                    symbol.data_type === 'REAL_TRADE' || symbol.data_type === 'REAL_DEPTH'
                );
                
                if (hasRealData) {
                    alertDiv.className += ' alert alert-success';
                    alertDiv.innerHTML = '<strong>✅ REAL DATA:</strong> Live Bookmap data flowing to dashboard';
                } else if (dataSource === 'FALLBACK') {
                    alertDiv.className += ' alert alert-warning';
                    alertDiv.innerHTML = '<strong>⚠️ FALLBACK MODE:</strong> ' + (data.message || 'Waiting for Bookmap connection');
                } else if (data.error) {
                    alertDiv.className += ' alert alert-danger';  
                    alertDiv.innerHTML = '<strong>❌ ERROR:</strong> ' + data.error;
                } else {
                    alertDiv.className += ' alert alert-warning';
                    alertDiv.innerHTML = '<strong>🟡 INITIALIZING:</strong> Waiting for real Bookmap data';
                }
                
                alertsContainer.appendChild(alertDiv);
            }
        }

        /**
         * View detailed analysis for a specific Bookmap window
         */
        function viewWindowDetails(windowId, symbol) {
            console.log(`📊 Viewing details for window: ${windowId} (${symbol})`);
            
            // Switch to Open Markets & Predictions section
            showSection('open-markets-predictions');
            
            // Update the section to focus on this specific window
            setTimeout(() => {
                updateOpenMarketsSection(windowId, symbol);
                
                // Scroll to the specific market if it exists
                const marketElement = document.getElementById(`market-${windowId}`);
                if (marketElement) {
                    marketElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    // Add highlight effect
                    marketElement.style.boxShadow = '0 0 20px rgba(76, 175, 80, 0.5)';
                    setTimeout(() => {
                        marketElement.style.boxShadow = '';
                    }, 3000);
                }
            }, 200);
        }

        /**
         * Update the Open Markets & Predictions section to show details for a specific window
         */
        function updateOpenMarketsSection(windowId, symbol) {
            const gridContainer = document.getElementById('open-markets-grid');
            const noMarketsMessage = document.getElementById('no-markets-message');
            
            if (!gridContainer) return;
            
            // Hide no markets message
            if (noMarketsMessage) {
                noMarketsMessage.style.display = 'none';
            }
            
            // Create detailed market analysis panel
            const marketPanel = createDetailedMarketPanel(windowId, symbol);
            
            // Clear existing content and add the detailed panel
            gridContainer.innerHTML = '';
            gridContainer.appendChild(marketPanel);
        }

        /**
         * Create a detailed analysis panel for a specific market window
         */
        function createDetailedMarketPanel(windowId, symbol) {
            const panel = document.createElement('div');
            panel.className = 'panel';
            panel.id = `market-${windowId}`;
            panel.style.gridColumn = '1 / -1'; // Full width
            
            // Get market type for styling
            const marketType = getMarketTypeFromSymbol(symbol);
            const typeColor = getMarketTypeColor(marketType);
            
            panel.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h2 style="color: ${typeColor}; margin: 0;">
                        <i class="fas fa-chart-line"></i> ${symbol} - Detailed Analysis
                        <span style="font-size: 0.6em; background: ${typeColor}; color: white; padding: 2px 6px; border-radius: 4px; margin-left: 10px;">
                            ${marketType}
                        </span>
                    </h2>
                    <button onclick="showAllMarkets()" style="background: #607d8b; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer;">
                        📊 Show All Markets
                    </button>
                </div>
                
                <!-- Enhanced Detection Metrics for this specific window -->
                <div class="grid grid-4" style="margin-bottom: 20px;">
                    <div class="panel" style="background: linear-gradient(135deg, #1e88e5, #1565c0);">
                        <h4 style="color: white; margin-top: 0;"><i class="fas fa-search"></i> Iceberg Detection</h4>
                        <div class="metric" style="color: white;">
                            <span>Status:</span>
                            <span class="metric-value">🟢 Active</span>
                        </div>
                        <div class="metric" style="color: white;">
                            <span>Accuracy:</span>
                            <span class="metric-value">94.2%</span>
                        </div>
                        <div class="metric" style="color: white;">
                            <span>Last Detection:</span>
                            <span class="metric-value">2m ago</span>
                        </div>
                    </div>
                    
                    <div class="panel" style="background: linear-gradient(135deg, #43a047, #2e7d32);">
                        <h4 style="color: white; margin-top: 0;"><i class="fas fa-layer-group"></i> Absorption Analysis</h4>
                        <div class="metric" style="color: white;">
                            <span>Strength:</span>
                            <span class="metric-value">High</span>
                        </div>
                        <div class="metric" style="color: white;">
                            <span>Direction:</span>
                            <span class="metric-value">Bullish</span>
                        </div>
                        <div class="metric" style="color: white;">
                            <span>Confidence:</span>
                            <span class="metric-value">89.7%</span>
                        </div>
                    </div>
                    
                    <div class="panel" style="background: linear-gradient(135deg, #fb8c00, #ef6c00);">
                        <h4 style="color: white; margin-top: 0;"><i class="fas fa-balance-scale"></i> Market Imbalance</h4>
                        <div class="metric" style="color: white;">
                            <span>Buy/Sell Ratio:</span>
                            <span class="metric-value">1.47</span>
                        </div>
                        <div class="metric" style="color: white;">
                            <span>Trend:</span>
                            <span class="metric-value">Bullish</span>
                        </div>
                        <div class="metric" style="color: white;">
                            <span>Volatility:</span>
                            <span class="metric-value">Medium</span>
                        </div>
                    </div>
                    
                    <div class="panel" style="background: linear-gradient(135deg, #8e24aa, #6a1b9a);">
                        <h4 style="color: white; margin-top: 0;"><i class="fas fa-brain"></i> Composite Signals</h4>
                        <div class="metric" style="color: white;">
                            <span>Signal Strength:</span>
                            <span class="metric-value">Strong Buy</span>
                        </div>
                        <div class="metric" style="color: white;">
                            <span>Consensus:</span>
                            <span class="metric-value">92%</span>
                        </div>
                        <div class="metric" style="color: white;">
                            <span>Next Target:</span>
                            <span class="metric-value" id="real-target-${windowId}">No Real Analysis</span>
                        </div>
                    </div>
                </div>
                
                <!-- Live Predictions and Analysis -->
                <div class="grid grid-2">
                    <div class="panel">
                        <h3><i class="fas fa-crystal-ball"></i> AI Predictions</h3>
                        <div class="alert alert-info" style="margin-bottom: 10px;">
                            <strong>Real Data Required:</strong> AI predictions require active Bookmap connection with real order flow data.
                        </div>
                        <div class="alert alert-warning" style="margin-bottom: 10px;">
                            <strong>Analysis Status:</strong> No real market analysis available. Connect to Bookmap for live predictions.
                        </div>
                        <div class="alert alert-info">
                            <strong>Risk Management:</strong> Risk levels will be calculated from real market volatility and position size when data is available.
                        </div>
                    </div>
                    
                    <div class="panel">
                        <h3><i class="fas fa-chart-area"></i> Pattern Analysis</h3>
                        <div style="margin-bottom: 15px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span>Order Flow Pattern:</span>
                                <span style="color: #666;" id="real-orderflow-${windowId}">No Real Data</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span>Support/Resistance:</span>
                                <span style="color: #666;" id="real-support-${windowId}">No Real Data</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span>Volume Profile:</span>
                                <span style="color: #666;" id="real-volume-${windowId}">No Real Data</span>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span>Market Maker Activity:</span>
                                <span style="color: #666;" id="real-activity-${windowId}">No Real Data</span>
                            </div>
                        </div>
                        <div class="alert alert-warning" style="margin-top: 10px; text-align: center;">
                            <strong>Pattern Analysis Requires Real Data</strong><br>
                            Open this market in Bookmap with the addon enabled to see real pattern analysis.
                        </div>
                    </div>
                </div>
            `;
            
            return panel;
        }

        /**
         * Show all markets instead of focusing on one
         */
        function showAllMarkets() {
            console.log('📊 Showing all active markets');
            updateOpenMarketsFromActiveWindows();
        }

        /**
         * Update Open Markets section to show all active windows
         */
        function updateOpenMarketsFromActiveWindows() {
            fetch('/api/bookmap/windows')
                .then(r => r.json())
                .then(data => {
                    const gridContainer = document.getElementById('open-markets-grid');
                    const noMarketsMessage = document.getElementById('no-markets-message');
                    
                    if (!gridContainer) return;
                    
                    const activeWindows = data.active_windows || [];
                    
                    if (activeWindows.length === 0) {
                        gridContainer.innerHTML = '';
                        if (noMarketsMessage) {
                            noMarketsMessage.style.display = 'block';
                        }
                        return;
                    }
                    
                    // Hide no markets message
                    if (noMarketsMessage) {
                        noMarketsMessage.style.display = 'none';
                    }
                    
                    // Create market cards for all active windows
                    let html = '';
                    activeWindows.forEach(window => {
                        const marketType = getMarketTypeFromSymbol(window.symbol);
                        const typeColor = getMarketTypeColor(marketType);
                        const changeColor = getChangeColor(window.change);
                        
                        html += `
                            <div class="panel">
                                <h3 style="color: ${typeColor};">
                                    <i class="fas fa-chart-line"></i> ${window.symbol}
                                    <span style="font-size: 0.6em; background: ${typeColor}; color: white; padding: 2px 6px; border-radius: 4px; margin-left: 8px;">
                                        ${marketType}
                                    </span>
                                </h3>
                                <div class="grid grid-2" style="gap: 10px; margin-bottom: 15px;">
                                    <div class="metric">
                                        <span>Price:</span>
                                        <span class="metric-value">$${window.price}</span>
                                    </div>
                                    <div class="metric">
                                        <span>Change:</span>
                                        <span class="metric-value" style="color: ${changeColor};">${window.change}%</span>
                                    </div>
                                    <div class="metric">
                                        <span>Volume:</span>
                                        <span class="metric-value">${window.volume}</span>
                                    </div>
                                    <div class="metric">
                                        <span>Activity:</span>
                                        <span class="metric-value">${window.last_activity}</span>
                                    </div>
                                </div>
                                <div style="text-align: center;">
                                    <button onclick="viewWindowDetails('${window.window_id || window.symbol}', '${window.symbol}')" 
                                            style="background: ${typeColor}; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; width: 100%;">
                                        📊 View Detailed Analysis
                                    </button>
                                </div>
                            </div>
                        `;
                    });
                    
                    gridContainer.innerHTML = html;
                })
                .catch(error => {
                    console.log('Error loading active windows:', error);
                    // Show demo markets if API fails
                    const gridContainer = document.getElementById('open-markets-grid');
                    if (gridContainer) {
                        gridContainer.innerHTML = `
                            <div class="panel">
                                <div class="alert alert-info">
                                    <strong>🔥 Real Data Only:</strong> Unable to connect to Bookmap. No simulated data available.
                                </div>
                                <p>Install the BookmapAI addon in Bookmap and open charts to see real market data and detailed analysis.</p>
                                <div style="margin-top: 15px; padding: 10px; background: #f8f9fa; border-radius: 4px;">
                                    <strong>Required steps:</strong>
                                    <ul style="margin: 10px 0; padding-left: 20px;">
                                        <li>Install BookmapAI addon in Bookmap</li>
                                        <li>Open market charts (NQ, ES, EURUSD, etc.)</li>
                                        <li>Enable the addon on each chart</li>
                                        <li>Real data will appear here automatically</li>
                                    </ul>
                                </div>
                            </div>
                        `;
                    }
                });
        }

        /**
         * Get market type from symbol name
         */
        function getMarketTypeFromSymbol(symbol) {
            if (symbol.includes('EUR') || symbol.includes('GBP') || symbol.includes('USD') || symbol.includes('JPY')) {
                return 'FOREX';
            } else if (symbol.includes('BTC') || symbol.includes('ETH') || symbol.includes('USDT')) {
                return 'CRYPTO';
            } else if (symbol.includes('ES') || symbol.includes('NQ') || symbol.includes('DEC') || symbol.includes('MAR')) {
                return 'FUTURES';
            } else {
                return 'UNKNOWN';
            }
        }

        function initializeChat() {
            const chatInput = document.getElementById('chat-input');
            if (chatInput) {
                chatInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        sendMessage();
                    }
                });
            }
        }

        function sendMessage() {
            const input = document.getElementById('chat-input');
            const message = input.value.trim();
            if (!message) return;
            addChatMessage(message, 'user');
            input.value = '';
            setTimeout(() => {
                const response = generateAIResponse(message);
                addChatMessage(response, 'ai');
            }, 1000);
        }

        function addChatMessage(message, sender) {
            const messagesContainer = document.getElementById('chat-messages');
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message ' + sender;
            messageDiv.innerHTML = message;
            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function generateAIResponse(userMessage) {
            const message = userMessage.toLowerCase();
            
            // ICT Patterns
            if (message.includes('fvg') || message.includes('fair value gap')) {
                return '📊 **Fair Value Gaps Analysis:**\n\n• **Active FVGs:** 12 détectés (8 bullish, 4 bearish)\n• **EURUSD:** FVG bullish à 1.0852-1.0857 (89% confiance)\n• **GBPUSD:** FVG bearish à 1.2745-1.2751 (86% confiance)\n\n**Trading Suggestion:**\nSurveiller les retests de ces gaps. Les FVG ont un taux de retest de 85%, offrant d\'excellentes opportunités d\'entrée avec un R:R de 1:2.5.';
            } else if (message.includes('order block') || message.includes('ob')) {
                return '🧱 **Order Blocks Analysis:**\n\n• **Active OBs:** 8 blocs détectés\n• **Success Rate:** 88.9% (hold rate: 73%)\n• **USDJPY:** Bullish OB à 149.65-149.78 (92% confiance)\n\n**Entry Strategy:**\nAttendre le rejet au niveau de l\'order block avec confirmation de volume. Stop loss: autre côté du bloc. Take profit: prochain niveau de liquidité.';
            } else if (message.includes('liquidity') || message.includes('sweep')) {
                return '💧 **Liquidity Sweeps Analysis:**\n\n• **Recent Sweeps:** 3 détectés aujourd\'hui\n• **Buy-side Success:** 84% | **Sell-side Success:** 81%\n• **USDJPY:** Buy-side sweep à 149.85 (84% confiance)\n\n**Trading Opportunity:**\nLes sweeps indiquent souvent une manipulation avant un mouvement opposé. Surveiller les reversals après liquidity grabs.';
            } else if (message.includes('bos') || message.includes('structure')) {
                return '🔨 **Break of Structure Analysis:**\n\n• **Bullish BOS:** 77.8% success rate\n• **Bearish BOS:** 76.2% success rate\n• **EURUSD:** Structure break bullish confirmé (79% confiance)\n\n**Market Context:**\nLe break de structure confirme un changement de tendance. Continuation probability: 79%. Chercher des pullbacks vers ancienne résistance devenue support.';
            } else if (message.includes('wyckoff')) {
                return '📈 **Wyckoff Analysis:**\n\n• **Current Phase:** Accumulation Phase C (Spring)\n• **Confidence:** 79.4%\n• **Expected Move:** Markup phase incoming\n\n**Phase Details:**\n- Selling climax identifié\n- Range de consolidation établi\n- Spring test en cours\n- Signs of Strength (SOS) à surveiller\n\n**Recommendation:** Position pour le markup avec stop sous le spring.';
            } else if (message.includes('sentiment') || message.includes('news')) {
                return '💭 **Market Sentiment Analysis:**\n\n• **Overall Sentiment:** Bullish (65%)\n• **Fear & Greed Index:** Neutral (52)\n• **News Impact:** Medium\n• **Institutional Flow:** Net buying (+15%)\n\n**Key Drivers:**\n- Fed dovish signals\n- Positive economic data\n- Risk-on environment\n\n**Trading Bias:** Bullish avec prudence sur les résistances majeures.';
            } else if (message.includes('marché') || message.includes('market')) {
                return '🌍 **Market Overview:**\n\n• **Trend Analysis:** Multi-timeframe bullish alignment (78% confluence)\n• **Volatility:** Moderate (ATR: 0.0145)\n• **Volume:** Above average (+23%)\n\n**Active Patterns:**\n- 12 Fair Value Gaps\n- 8 Order Blocks\n- 3 Liquidity Sweeps\n- 5 Supply/Demand zones\n\n**Best Opportunities:** EURUSD, GBPUSD show strong ICT setups.';
            } else if (message.includes('strategy') || message.includes('stratégie')) {
                return '🎯 **Enhanced Trading Strategy:**\n\n**1. ICT-Based Approach:**\n- Focus on FVG retests (85.7% success)\n- Order block rejections (88.9% success)\n- Liquidity sweep reversals (82.5% success)\n\n**2. Multi-Timeframe:**\n- 1D: Trend direction\n- 4H: Entry zones\n- 1H: Precise timing\n- 15M: Execution\n\n**3. Risk Management:**\n- Max 2% per trade\n- R:R minimum 1:2\n- Portfolio heat < 6%\n\n**Current Bias:** Bullish with ICT confirmation.';
            } else if (message.includes('risk') || message.includes('risque')) {
                return '⚠️ **Advanced Risk Management:**\n\n**Current Exposure:**\n- Portfolio Heat: 4.2% (Safe)\n- Correlation Risk: Low\n- Max Drawdown: 2.1%\n\n**Risk Metrics:**\n- VaR (95%): 1.8%\n- Sharpe Ratio: 2.34\n- Maximum Risk per Trade: 2%\n\n**Recommendations:**\n- Maintain current position sizing\n- Monitor correlation between USD pairs\n- Use volatility-adjusted stops\n\n**Alert Thresholds:**\n- Portfolio heat > 6%: Reduce positions\n- Correlation > 0.7: Diversify';
            } else if (message.includes('setup') || message.includes('trade')) {
                return '⚡ **Live Trading Setups:**\n\n**1. EURUSD (15M)**\n- Pattern: Bullish FVG retest\n- Entry: 1.0852-1.0855\n- Stop: 1.0848\n- Target: 1.0867 (R:R 1:2.5)\n- Confidence: 89%\n\n**2. GBPUSD (1H)**\n- Pattern: Bearish Order Block\n- Entry: 1.2745-1.2751\n- Stop: 1.2755\n- Target: 1.2720 (R:R 1:2.8)\n- Confidence: 86%\n\n**3. USDJPY (5M)**\n- Pattern: Liquidity Sweep Reversal\n- Entry: 149.82\n- Stop: 149.88\n- Target: 149.65 (R:R 1:2.8)\n- Confidence: 84%';
            } else if (message.includes('performance') || message.includes('stats')) {
                return '📊 **System Performance Stats:**\n\n**Overall Accuracy:** 87.3%\n\n**Pattern Success Rates:**\n- Fair Value Gaps: 85.7%\n- Order Blocks: 88.9%\n- Liquidity Sweeps: 82.5%\n- BOS Patterns: 77.8%\n- Wyckoff Phases: 79.4%\n\n**Monthly Performance:**\n- Win Rate: 73%\n- Avg R:R: 1:2.4\n- Max Drawdown: 3.2%\n- Profit Factor: 2.1\n\n**AI Enhancement:** +12% accuracy improvement\n**Sentiment Integration:** +8% timing precision';
            } else {
                return '🤖 **BookmapAI Enhanced Assistant**\n\nJe peux vous aider avec:\n\n**📈 ICT Analysis:**\n- Fair Value Gaps (FVG)\n- Order Blocks (OB)\n- Liquidity Sweeps\n- Break of Structure (BOS)\n- Wyckoff Phases\n\n**📊 Market Intelligence:**\n- Sentiment analysis\n- Multi-timeframe confluence\n- Supply/demand zones\n- Risk management\n\n**🎯 Trading Support:**\n- Live setups\n- Entry/exit strategies\n- Performance tracking\n\n**Questions populaires:**\n"Show me FVG setups", "Wyckoff analysis", "Current sentiment", "Risk status", "Live setups"';
            }
        }

        function updateElement(id, value) {
            const element = document.getElementById(id);
            if (element) {
                element.textContent = value;
            }
        }
        
        /**
         * Enhanced update function with colorization and animation based on value changes
         */
        function updateElementWithColor(id, newValue, key) {
            const element = document.getElementById(id);
            if (!element) return;
            
            const currentValue = element.textContent;
            const previousValue = previousValues[key];
            
            // Store new value as previous for next comparison
            previousValues[key] = newValue.toString();
            
            // Skip animation on first load
            if (previousValue === undefined) {
                element.textContent = newValue;
                return;
            }
            
            // Check if value changed
            if (currentValue !== newValue.toString()) {
                // Remove any existing animation classes
                element.classList.remove('value-updated', 'value-increased', 'value-decreased', 'value-new');
                
                // Update the text content
                element.textContent = newValue;
                
                // Determine the type of change for colorization
                const isNumeric = !isNaN(parseFloat(newValue.toString().replace(/[^0-9.-]/g, '')));
                
                if (isNumeric) {
                    const oldNum = parseFloat(previousValue.replace(/[^0-9.-]/g, ''));
                    const newNum = parseFloat(newValue.toString().replace(/[^0-9.-]/g, ''));
                    
                    if (newNum > oldNum) {
                        element.classList.add('value-increased');
                    } else if (newNum < oldNum) {
                        element.classList.add('value-decreased');
                    } else {
                        element.classList.add('value-updated');
                    }
                } else {
                    // Non-numeric values get general update animation
                    if (previousValue !== newValue.toString()) {
                        element.classList.add('value-new');
                    } else {
                        element.classList.add('value-updated');
                    }
                }
                
                // Remove animation class after animation completes
                setTimeout(() => {
                    element.classList.remove('value-updated', 'value-increased', 'value-decreased', 'value-new');
                }, 2500);
            }
        }

        function updateOpenMarkets(markets) {
            const container = document.getElementById('open-markets-container');
            if (container && markets.length > 0) {
                container.innerHTML = markets.map(market => 
                    '<div class="market-card"><div class="market-name">' + market.name + 
                    '</div><div class="market-status"><span class="status-indicator ' + market.status + 
                    '"></span>' + market.session_info + '</div></div>'
                ).join('');
            }
        }

        function updateActiveSymbols(symbols) {
            const container = document.getElementById('active-symbols-container');
            if (container && symbols.length > 0) {
                container.innerHTML = symbols.map(symbol => 
                    '<div class="market-card"><div class="market-name">' + symbol.name + 
                    '</div><div class="market-status">Price: ' + symbol.price + 
                    ' | Vol: ' + symbol.volume + '</div></div>'
                ).join('');
            }
        }
</script> 
</body>
</html> 
