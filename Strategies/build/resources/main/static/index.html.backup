                }
            ];
            
            // Display demo sessions
            displayActiveSessions(demoSessions);
            
            // Update counters to show demo data
            updateElementWithColor('active-sessions-count', demoSessions.length, 'active-sessions-count');
            updateElementWithColor('active-windows-count', demoSessions.length, 'active-windows-count');
            
            // Update status
            const statusElement = document.getElementById('sessions-status');
            if (statusElement) {
                statusElement.innerHTML = '<span style="color: #f39c12;">🟡 DEMO MODE - Showing Example Sessions</span>';
            }
            
            // Add demo banner
            const container = document.getElementById('active-sessions-container');
            if (container) {
                const demoBanner = document.createElement('div');
                demoBanner.id = 'demo-banner';
                demoBanner.innerHTML = `
                    <div style="background: linear-gradient(135deg, #f39c12, #e67e22); color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center; box-shadow: 0 4px 8px rgba(243, 156, 18, 0.3);">
                        <h4 style="margin: 0 0 10px 0;"><i class="fas fa-star"></i> 🎯 DEMO SESSION PREVIEW</h4>
                        <p style="margin: 0; font-size: 0.9em;">This shows exactly what your individual session panels will look like with real Bookmap data!</p>
                        <div style="margin-top: 10px;">
                            <button onclick="clearDemoSessions()" style="background: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.3); padding: 8px 16px; border-radius: 20px; cursor: pointer; font-size: 0.9em;">
                                <i class="fas fa-times"></i> Clear Demo
                            </button>
                        </div>
                    </div>
                `;
                container.insertBefore(demoBanner, container.firstChild);
            }
            
            console.log('🎯 Demo sessions displayed - showing example of individual session panels');
        }
        
        function clearDemoSessions() {
            // Clear demo session protection flag
            demoSessionsActive = false;
            
            // Remove demo banner
            const demoBanner = document.getElementById('demo-banner');
            if (demoBanner) {
                demoBanner.remove();
            }
            
            // Clear sessions and show no sessions message
            clearActiveSessions();
            showNoSessionsMessage();
            
            // Reset counters
            updateElementWithColor('active-sessions-count', '0', 'active-sessions-count');
            updateElementWithColor('active-windows-count', '0', 'active-windows-count');
            
            // Reset status
            const statusElement = document.getElementById('sessions-status');
            if (statusElement) {
                statusElement.innerHTML = '<span style="color: #f39c12;">🟡 No Active Sessions - Open Bookmap Charts</span>';
            }
            
            console.log('🧹 Demo sessions cleared - back to waiting for real data');
        }
        
        function getCurrentTime() {
            const now = new Date();
            return now.getHours().toString().padStart(2, '0') + ':' + 
                   now.getMinutes().toString().padStart(2, '0') + ':' + 
                   now.getSeconds().toString().padStart(2, '0');
        }
        
        /**
         * Show Main Demo Session - For the dedicated Active Trading Sessions section
         */
        function showMainDemoSession() {
            // Set main demo session protection flag to prevent auto-clearing
            mainDemoSessionsActive = true;
            
            // Hide no sessions message
            hideMainNoSessionsMessage();
            
            // Create demo session data (same as regular demo but for main section)
            const demoSessions = [
                {
                    session_id: 'MAIN_DEMO_ESU5_001',
