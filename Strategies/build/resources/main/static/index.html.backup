                    last_update: getCurrentTime(),
                    patterns: [
                        { type: 'ICEBERG_DETECTED', confidence: 87.5, description: 'Large hidden order detected at $4485 level' },
                        { type: 'ABSORPTION_PATTERN', confidence: 84.2, description: 'Volume absorption at key resistance' },
                        { type: 'MARKET_IMBALANCE', confidence: 76.8, description: 'Buy-side order flow imbalance' }
                    ],
                    predictions: [
                        { direction: 'UP', confidence: 92.3, target: '4495.00', timeframe: '5-10 minutes' },
                        { direction: 'DOWN', confidence: 79.1, target: '4480.00', timeframe: '15-20 minutes' }
                    ],
                    order_flow: 'Bullish',
                    market_pressure: 'Strong Buy',
                    volatility: 'Normal',
