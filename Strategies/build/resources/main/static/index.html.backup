                },
                {
                    session_id: 'MAIN_DEMO_NQU5_002',
                    symbol: 'NQU5',
                    market_type: 'FUTURES',
                    current_price: 15234.75,
                    price_change: '+0.28%',
                    volume: '1,240',
                    volume_level: 'High',
                    last_update: getCurrentTime(),
                    patterns: [
                        { type: 'COMPOSITE_SIGNAL', confidence: 91.7, description: 'Multi-pattern confluence detected' },
                        { type: 'ABSORPTION_PATTERN', confidence: 83.4, description: 'Market maker accumulation' }
                    ],
                    predictions: [
                        { direction: 'UP', confidence: 88.9, target: '15280.00', timeframe: '8-12 minutes' },
                        { direction: 'UP', confidence: 82.3, target: '15320.00', timeframe: '30-45 minutes' }
                    ],
                    order_flow: 'Strong Bullish',
                    market_pressure: 'Momentum Buy',
