        "category": "volume_analysis", 
        "priority": "core",
        "accuracy_rating": 94,
        
        "technical_definition": {
          "description": "دلتا الحجم التراكمي تقيس الفرق التراكمي بين أحجام الشراء والبيع عبر الزمن لتحديد الاتجاه الأساسي للسوق",
          "algorithm_type": "Cumulative Net Volume Flow Analysis",
          "data_requirements": ["Buy volume", "Sell volume", "Timestamp data"],
          "calculation_method": "CVD = Σ(Buy_Volume - Sell_Volume) over time period"
        },
        
        "core_parameters": {
          "calculation_modes": {
            "session_based": "Resets at session start",
            "continuous": "Never resets, shows long-term trend", 
